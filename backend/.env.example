# Salin ke .env (JANGAN commit .env — berisi rahasia).
PORT=8080
DATABASE_URL=postgres://brandingpulse:brandingpulse@localhost:5432/brandingpulse?sslmode=disable
# WAJIB: string acak >= 32 karakter. Generate: openssl rand -base64 48
# Tanpa ini API menolak start (tidak ada lagi fallback lemah).
JWT_SECRET=ganti-dengan-minimal-32-karakter-acak
# Hash bcrypt (cost 12) password admin. Generate:
#   htpasswd -bnBC 12 "" 'PASSWORD_KUAT' | tr -d ':\n'
# Tanpa ini login admin DITOLAK (tidak ada lagi fallback admin123).
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=admin@brandingpulse.co
FRONTEND_URL=http://127.0.0.1:4321
# koma-dipisah; FRONTEND_URL selalu diizinkan otomatis.
# Hanya set TRUST_PROXY_HEADERS=1 di belakang nginx yang menimpa X-Forwarded-For.
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:5174,http://127.0.0.1:5174
UPLOAD_DIR=uploads
