---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Page not found — LogoPulse">
  <Navbar />
  <main class="mx-auto max-w-xl px-5 pt-40 pb-24 text-center">
    <p class="font-serif-accent text-7xl text-primary">404</p>
    <h1 class="mt-4 text-3xl font-extrabold" data-site="pages.n404_title">This page went off-brand</h1>
    <p class="mt-2 text-slate-500">The link you followed doesn&apos;t exist. Let&apos;s get you back to good design.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a href="/" data-site="pages.n404_home" class="btn-active rounded-full bg-primary px-6 py-3 text-sm font-bold text-white hover:bg-primary-hover">Back home</a>
      <a href="/#pricing" data-site="pages.n404_pricing" class="btn-active rounded-full bg-dark px-6 py-3 text-sm font-bold text-white hover:bg-slate-800">View pricing</a>
    </div>
  </main>
  <Footer />
  <script>
    // Fallback cerdas: slug blog/case baru yang belum ikut build statis
    // tetap bisa dibuka — diambil dari API lalu dirender di sini.
    // Setelah build ulang, halaman SSG asli yang melayani.
    (function () {
      var m = location.pathname.match(/^\/(blog|case-studies)\/([^/]+)\/?$/);
      if (!m) return;
      var kind = m[1], slug = decodeURIComponent(m[2]);
      var base = (window.__lpApiBase || 'http://localhost:8080/api/v1');
      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function looksHtml(s) { return /<[a-z][\s>]/i.test(s || ''); }
      function bodyHtml(s) {
        if (!s) return '';
        return looksHtml(s) ? s : '<p>' + esc(s) + '</p>';
      }
      function fmt(iso) {
        var d = String(iso || '').slice(0, 10).split('-');
        return d.length === 3 ? d[2] + '/' + d[1] + '/' + d[0] : String(iso || '');
      }
      var SHARE_SVGS = {
        x: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.3 22h-6.3l-4.9-6.4L6.5 22H3.4l7.3-8.3L1 2h6.5l4.4 5.9L18.9 2zm-1.1 17.8h1.7L7.6 3.9H5.8l12 16z"/></svg>',
        facebook: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.7c0-.9.3-1.6 1.6-1.6h1.7V4.2c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.4V14h2.7v8h3.4z"/></svg>',
        linkedin: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.9 8.6H3.6V21h3.3V8.6zM5.2 3.5a1.9 1.9 0 100 3.9 1.9 1.9 0 000-3.9zM21 13.4c0-3.2-1.7-4.7-4-4.7-1.8 0-2.7 1-3.1 1.7V8.6h-3.4V21h3.4v-6.6c0-1.6.8-2.5 2-2.5s1.9.9 1.9 2.5V21H21v-7.6z"/></svg>',
        whatsapp: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 01-3.3-2.9c-.3-.4 0-.5.1-.7l.5-.6c.1-.2.1-.4 0-.5L9.4 8c-.2-.5-.5-.4-.6-.4h-.5c-.2 0-.5.2-.7.6-.9 1-.3 2.7.6 4.1a11.2 11.2 0 004.3 3.8c1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2 0-.1-.2-.1-.4-.2z"/></svg>',
        copy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 007.5.5l3-3a5 5 0 00-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 00-7.5-.5l-3 3a5 5 0 007 7l1.7-1.7"/></svg>'
      };
      function shareBtns() {
        return ['x', 'facebook', 'linkedin', 'whatsapp', 'copy'].map(function (k) {
          var label = k === 'copy' ? 'Copy link' : 'Share on ' + (k === 'x' ? 'X' : k.charAt(0).toUpperCase() + k.slice(1));
          return '<button type="button" data-share="' + k + '" aria-label="' + label + '" title="' + label + '" class="share-btn">' + SHARE_SVGS[k] + '</button>';
        }).join('');
      }
      document.addEventListener('click', function (e) {
        var b = e.target && e.target.closest ? e.target.closest('[data-share]') : null;
        if (!b) return;
        var type = b.getAttribute('data-share');
        var url = location.href, text = document.title;
        var enc = encodeURIComponent;
        if (type === 'copy') {
          var done = function () {
            var old = b.innerHTML;
            b.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9.5 18 20 6.5"/></svg>';
            setTimeout(function () { b.innerHTML = old; }, 1500);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(done).catch(done);
          else done();
          return;
        }
        var links = {
          x: 'https://twitter.com/intent/tweet?text=' + enc(text) + '&url=' + enc(url),
          facebook: 'https://www.facebook.com/sharer/sharer.php?u=' + enc(url),
          linkedin: 'https://www.linkedin.com/sharing/share-offsite/?url=' + enc(url),
          whatsapp: 'https://wa.me/?text=' + enc(text + ' ' + url),
        };
        if (links[type]) window.open(links[type], '_blank', 'noopener,width=600,height=540');
      });
      fetch(base + '/' + (kind === 'blog' ? 'blog' : 'case-studies') + '/' + encodeURIComponent(slug), { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (j) {
          var d = (j && (j.data || j)) || null;
          if (!d || (!d.title && !d.client)) return;
          var main = document.querySelector('main');
          if (!main) return;
          if (kind === 'blog') {
            var title = d.meta_title || d.title || 'Untitled';
            var cover = d.thumbnail_url || '';
            var date = fmt(d.published_at || d.created_at || '');
            document.title = title + ' — LogoPulse Blog';
            main.className = 'mx-auto max-w-3xl px-5 pt-32 pb-20';
            main.style.textAlign = 'left';
            main.innerHTML =
              (cover ? '<img src="' + esc(cover) + '" alt="' + esc(d.title || '') + '" class="w-full object-cover" style="border-radius:16px" />' : '')
              + '<h1 class="mt-6 text-4xl font-extrabold tracking-tight">' + esc(d.title || '') + '</h1>'
              + '<div class="mt-4">'
              + '<p class="text-sm text-slate-500">Written by <span class="font-semibold text-slate-700">Admin</span> on ' + esc(date) + '</p>'
              + '</div>'
              + '<hr class="my-6 border-slate-200" />'
              + '<div class="post-body text-slate-700 leading-relaxed">' + bodyHtml(d.content || d.meta_description || '') + '</div>'
              + '<div class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200" style="border-radius:20px">'
              + '<p class="text-sm font-extrabold">Share this article</p>'
              + '<div class="flex items-center gap-2">' + shareBtns() + '</div>'
              + '</div>'
              + '<a href="/order?plan=professional" class="mt-8 inline-block rounded-full bg-primary px-6 py-3 text-sm font-bold text-white">Get my logo — from $49</a>';
          } else {
            var client = d.client || d.title || 'Case study';
            document.title = client + ' — LogoPulse Case Study';
            main.className = 'mx-auto max-w-3xl px-5 pt-32 pb-20';
            main.style.textAlign = 'left';
            main.innerHTML =
              '<nav class="flex items-center gap-2 text-sm text-slate-500"><a href="/" class="hover:text-primary">Home</a><span>/</span><a href="/case-studies" class="hover:text-primary">Case studies</a><span>/</span><span class="font-semibold text-slate-900">' + esc(client) + '</span></nav>'
              + '<p class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-primary">' + esc(d.industry || 'Brand identity') + ' · Brand identity</p>'
              + '<h1 class="mt-2 text-4xl sm:text-5xl font-extrabold tracking-tight">' + esc(client) + '</h1>'
              + '<p class="mt-4 text-lg text-slate-600 leading-relaxed">' + esc(d.excerpt || d.content || '') + '</p>'
              + '<div class="post-body mt-6 text-slate-600 leading-relaxed">' + bodyHtml(d.content || '') + '</div>'
              + '<div class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200" style="border-radius:20px">'
              + '<p class="text-sm font-extrabold">Share this case study</p>'
              + '<div class="flex items-center gap-2">' + shareBtns() + '</div>'
              + '</div>';
          }
        }).catch(function () {});
    })();
  </script>
</BaseLayout>
