---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { FALLBACK_CASES } from '../../lib/api';
---
<BaseLayout title="Case Studies — LogoPulse">
  <Navbar />
  <main class="mx-auto max-w-content px-5 pt-32 pb-20">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary" data-site="sections.cases_kicker">Case studies</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight" data-site="pages.cases_title">Results, not just pretty marks</h1>
    <div id="cases-grid" class="mt-8 grid gap-5 sm:grid-cols-2">
      {FALLBACK_CASES.map((c) => (
        <a href={`/case-studies/${c.slug}`} class="block overflow-hidden bg-white ring-1 ring-slate-900/10 hover:shadow-xl transition hover:-translate-y-1" style="border-radius:20px">
          <img src={c.mockup} alt={c.client} loading="lazy" class="aspect-[16/9] w-full object-cover" />
          <div class="p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-primary">{c.industry} · {c.result}</p>
            <h2 class="mt-1 font-extrabold">{c.title}</h2>
            <p class="mt-1 text-sm text-slate-500">{c.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
  <script>
    // Hydrate case list from API; diam bila offline (fallback SSR tetap tampil).
    (function () {
      var grid = document.getElementById('cases-grid');
      if (!grid) return;
      var base = (window.__lpApiBase || 'http://localhost:8080/api/v1');
      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      fetch(base + '/case-studies?limit=24', { cache: 'no-store' }).then(function (r) {
        return r.ok ? r.json() : null;
      }).then(function (j) {
        var list = (j && (j.data || j)) || [];
        if (!Array.isArray(list) || list.length === 0) return;
        grid.innerHTML = list.map(function (c) {
          var mockup = c.mockup || c.hero_image || '';
          var excerpt = c.excerpt || c.content || '';
          return '<a href="/case-studies/' + esc(c.slug) + '" class="block overflow-hidden bg-white ring-1 ring-slate-900/10 hover:shadow-xl transition hover:-translate-y-1" style="border-radius:20px">'
            + (mockup ? '<img src="' + esc(mockup) + '" alt="' + esc(c.client || c.title) + '" loading="lazy" class="aspect-[16/9] w-full object-cover" />' : '')
            + '<div class="p-5">'
            + '<p class="text-xs font-bold uppercase tracking-wider text-primary">' + esc(c.industry || 'Brand identity') + (c.result ? ' · ' + esc(c.result) : '') + '</p>'
            + '<h2 class="mt-1 font-extrabold">' + esc(c.title) + '</h2>'
            + '<p class="mt-1 text-sm text-slate-500">' + esc(String(excerpt).slice(0, 160)) + '</p>'
            + '</div></a>';
        }).join('');
      }).catch(function () {});
    })();
  </script>
</BaseLayout>
