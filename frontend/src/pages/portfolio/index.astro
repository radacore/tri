---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { API } from '../../lib/api';
import {
  categoriesFrom,
  portfolioCardHTML,
  type Category,
  type PortfolioCard,
} from '../../lib/portfolio';

// Item diambil saat build dari admin; API mati = halaman menampilkan pesan kosong.
let items: PortfolioCard[] = [];
try {
  const r = await fetch(`${API}/portfolio?limit=100`);
  if (r.ok) {
    const j = await r.json();
    const list: PortfolioCard[] = (j?.data ?? j) ?? [];
    if (Array.isArray(list)) items = list.filter((p) => p?.image_url);
  }
} catch { /* build offline */ }

let categories: string[] = [];
try {
  const r = await fetch(`${API}/categories`);
  if (r.ok) {
    const j = await r.json();
    const list: Category[] = (j?.data ?? j) ?? [];
    if (Array.isArray(list)) categories = list.map((c) => c.name).filter(Boolean);
  }
} catch { /* build offline — turunkan dari item */ }
if (categories.length === 0) categories = categoriesFrom(items);

const filters = ['All', ...categories];
const cards = items.map((p) => portfolioCardHTML(p)).join('');
---
<BaseLayout title="Portfolio — BrandingPulse">
  <Navbar />
  <main class="mx-auto max-w-content px-5 pt-32 pb-20">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Portfolio</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight">Selected work</h1>
    <div id="pf-filters" class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Filter portfolio">
      {filters.map((f, i) => (
        <button
          type="button"
          data-filter={f}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class={`pf-btn btn-active rounded-full px-4 py-2 text-sm font-bold border transition ${i === 0 ? 'bg-black text-white border-black' : 'border-gray-300 text-gray-700 hover:bg-gray-100 bg-white'}`}
        >{f}</button>
      ))}
    </div>
    <div id="pf-grid" class="relative mt-8 grid grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-4 [grid-auto-flow:dense]" set:html={cards}>
    </div>
    {items.length === 0 && (
      <p class="mt-10 text-sm text-slate-500">No published work yet. Add items from the admin portfolio page.</p>
    )}
  </main>
  <Footer />
  <script>
    import { fetchCategories } from '../../lib/portfolio';

    (function () {
      var btns = Array.from(document.querySelectorAll('.pf-btn'));
      var items = Array.from(document.querySelectorAll('.pf-item'));
      var grid = document.getElementById('pf-grid');
      var PILL = 'pf-btn btn-active rounded-full px-4 py-2 text-sm font-bold border transition ';
      function paint(active) {
        btns.forEach(function (b) {
          var on = b.getAttribute('data-filter') === active;
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
          b.className = PILL + (on ? 'bg-black text-white border-black' : 'border-gray-300 text-gray-700 hover:bg-gray-100 bg-white');
        });
      }
      function select(f) {
        paint(f);
        if (grid) grid.classList.toggle('pf-uniform', f !== 'All');
        items.forEach(function (it) {
          var show = f === 'All' || it.getAttribute('data-category') === f;
          it.classList.toggle('pf-hidden', !show);
        });
      }
      function bind() {
        btns.forEach(function (b) {
          b.addEventListener('click', function () { select(b.getAttribute('data-filter') || 'All'); });
        });
      }
      bind();
      fetchCategories().then(function (list) {
        if (list.length === 0) return;
        var wrap = document.getElementById('pf-filters');
        if (!wrap) return;
        wrap.innerHTML = '';
        ['All'].concat(list.map(function (c) { return c.name; })).forEach(function (name, i) {
          var b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('data-filter', name);
          b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
          b.className = PILL + (i === 0 ? 'bg-black text-white border-black' : 'border-gray-300 text-gray-700 hover:bg-gray-100 bg-white');
          b.textContent = name;
          wrap.appendChild(b);
        });
        btns = Array.from(wrap.querySelectorAll('.pf-btn'));
        bind();
      });
    })();
  </script>
</BaseLayout>
