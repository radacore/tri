---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { API } from '../../lib/api';
import {
  categoriesFrom,
  portfolioCardHTML,
  type Category,
  type PortfolioCard,
} from '../../lib/portfolio';

let categories: Category[] = [];
try {
  const r = await fetch(`${API}/categories`);
  if (r.ok) {
    const j = await r.json();
    const list: Category[] = (j?.data ?? j) ?? [];
    if (Array.isArray(list)) categories = list.filter((c) => c?.slug && c?.name);
  }
} catch { /* build offline — fallback slug */ }

export async function getStaticPaths() {
  let slugs = ['tech', 'fnb', 'fashion', 'health'];
  try {
    const r = await fetch(`${API}/categories`);
    if (r.ok) {
      const j = await r.json();
      const list: Category[] = (j?.data ?? j) ?? [];
      if (Array.isArray(list) && list.length > 0) slugs = list.map((c) => c.slug);
    }
  } catch { /* build offline — fallback slugs */ }
  return slugs.map((slug) => ({ params: { category: slug } }));
}

const { category } = Astro.params;
const current = categories.find((c) => c.slug === category);
const categoryName = current?.name ?? category;

let items: PortfolioCard[] = [];
try {
  const r = await fetch(`${API}/portfolio?limit=100`);
  if (r.ok) {
    const j = await r.json();
    const list: PortfolioCard[] = (j?.data ?? j) ?? [];
    if (Array.isArray(list)) items = list.filter((p) => p?.image_url);
  }
} catch { /* build offline */ }

const mine = items.filter((p) => (p.category ?? '') === categoryName);
const cards = mine.map((p) => portfolioCardHTML(p)).join('');
if (categories.length === 0) {
  categories = categoriesFrom(items).map((name) => ({
    name,
    slug: name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
  }));
}
---
<BaseLayout title={`${categoryName} — BrandingPulse Portfolio`}>
  <Navbar />
  <main class="mx-auto max-w-content px-5 pt-32 pb-20">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-slate-500">
      <a href="/" class="hover:text-primary">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/portfolio" class="hover:text-primary">Portfolio</a>
      <span aria-hidden="true">/</span>
      <span class="font-semibold capitalize text-slate-900">{categoryName}</span>
    </nav>
    <h1 class="mt-4 text-4xl font-extrabold capitalize tracking-tight">{categoryName}</h1>
    <p class="mt-2 text-sm text-slate-500">{mine.length} {mine.length === 1 ? 'work' : 'works'}</p>
    <div id="pf-grid" class="relative mt-8 grid grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-4 [grid-auto-flow:dense]" set:html={cards}>
    </div>
    {mine.length === 0 && (
      <p class="mt-10 text-sm text-slate-500">No published work in this category yet.</p>
    )}
    <div class="mt-10 flex flex-wrap gap-2">
      {categories.map((c) => (
        <a
          href={`/portfolio/${c.slug}`}
          class={`rounded-full px-4 py-2 text-sm font-bold border transition ${c.slug === category ? 'bg-black text-white border-black' : 'border-gray-300 text-gray-700 hover:bg-gray-100 bg-white'}`}
        >{c.name}</a>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
