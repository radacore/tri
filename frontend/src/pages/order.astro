---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
// Fallback bila API mati; diganti key pricing dari admin saat load.
const FALLBACK_PLANS: Record<string, { name: string; price: number }> = {
  starter: { name: 'Starter', price: 49 },
  professional: { name: 'Professional', price: 149 },
  premium: { name: 'Premium', price: 399 },
};
const q = (Astro.url.searchParams.get('plan') ?? 'professional').toLowerCase();
const initial = FALLBACK_PLANS[q] ?? FALLBACK_PLANS['professional'];
const apiBase = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080/api/v1';
const waNumberFallback = import.meta.env.PUBLIC_WA_NUMBER ?? '6281241525485';
const orderEmailFallback = import.meta.env.PUBLIC_ORDER_EMAIL ?? 'hello@logopulse.co';
const VIBES = ['minimalis', 'berani', 'elegan', 'playful', 'klasik', 'futuristis', 'mewah', 'organik'];
const COLORS = [
  { k: 'biru', hex: '#2563EB' },
  { k: 'hitam', hex: '#111111' },
  { k: 'emas', hex: '#C9A227' },
  { k: 'hijau', hex: '#16A34A' },
  { k: 'merah', hex: '#DC2626' },
  { k: 'ungu', hex: '#7C3AED' },
  { k: 'monokrom', hex: '#6B7280' },
];
---
<BaseLayout title="Order — LogoPulse">
  <Navbar />
  <main class="mx-auto max-w-3xl px-5 pt-32 pb-20">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary text-center" data-site="pages.order_kicker">Order</p>
    <h1 class="mt-2 text-center text-4xl font-extrabold tracking-tight" data-site="pages.order_title">Start your logo</h1>
    <p class="mt-3 text-center text-sm text-slate-500" data-site="pages.order_sub">Fill a short brief, then send it straight via WhatsApp or email — no upfront payment.</p>
    <ol class="mt-8 flex items-center justify-center gap-2 text-xs font-bold" id="order-steps">
      <li data-step="1" data-site="pages.order_s1" class="rounded-full bg-dark px-4 py-2 text-white">1 · Brief</li>
      <li data-step="2" data-site="pages.order_s2" class="rounded-full bg-slate-100 px-4 py-2 text-slate-500">2 · Review</li>
      <li data-step="3" data-site="pages.order_s3" class="rounded-full bg-slate-100 px-4 py-2 text-slate-500">3 · Send</li>
    </ol>
    <div class="mt-6 rounded-2xl bg-white p-6 sm:p-8 ring-1 ring-slate-900/10 shadow-sm" style="border-radius:20px">
      <!-- STEP 1 -->
      <div id="os-1">
        <div id="plan-grid" class="grid gap-4 sm:grid-cols-3" role="radiogroup" aria-label="Choose a plan">
          {Object.entries(FALLBACK_PLANS).map(([key, p]) => (
            <button type="button" data-plan={key} data-price={p.price} class={`plan-btn btn-active rounded-2xl px-4 py-4 text-left ring-2 transition ${key === (FALLBACK_PLANS[q] ? q : 'professional') ? 'ring-primary bg-subtle/50' : 'ring-slate-200'}`}>
              <span class="block font-extrabold">{p.name}</span>
              <span class="tabular text-2xl font-extrabold">${p.price}</span>
            </button>
          ))}
        </div>
        <div class="mt-5 grid gap-5">
          <label class="text-sm font-bold"><span data-site="pages.order_f_name">Your name</span><input id="f-name" data-site-ph="pages.order_ph_name" class="mt-1 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-normal" placeholder="Full name" /></label>
          <label class="text-sm font-bold"><span data-site="pages.order_f_biz">Company / brand name</span><input id="f-business" data-site-ph="pages.order_ph_biz" class="mt-1 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-normal" placeholder="Acme Inc." /></label>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="text-sm font-bold"><span data-site="pages.order_f_ind">Industry</span><input id="f-industry" data-site-ph="pages.order_ph_ind" class="mt-1 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-normal" placeholder="SaaS, café, fashion…" /></label>
            <label class="text-sm font-bold"><span data-site="pages.order_f_target">Target market</span><input id="f-target" data-site-ph="pages.order_ph_target" class="mt-1 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-normal" placeholder="E.g. young moms 25–35, Jakarta" /></label>
          </div>
          <label class="text-sm font-bold"><span data-site="pages.order_f_contact">Email or WhatsApp number</span><input id="f-contact" data-site-ph="pages.order_ph_contact" class="mt-1 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-normal" placeholder="you@company.com / 0812…" /></label>
          <fieldset>
            <legend class="text-sm font-bold"><span data-site="pages.order_f_vibe">Style / vibe</span> <span class="font-semibold text-slate-400" data-site="pages.order_vibe_hint">Pick up to 3 — this replaces the discovery call.</span></legend>
            <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Vibe">
              {VIBES.map((v) => (
                <button type="button" data-vibe={v} aria-pressed="false" class="vibe-chip btn-active rounded-full px-4 py-2 text-sm font-bold ring-1 ring-slate-200 bg-white text-slate-600 hover:ring-slate-400 transition">{v}</button>
              ))}
            </div>
          </fieldset>
          <fieldset>
            <legend class="text-sm font-bold" data-site="pages.order_f_color">Color references</legend>
            <div class="mt-2 flex flex-wrap items-center gap-2" role="group" aria-label="Colors">
              {COLORS.map((c) => (
                <button type="button" data-color={c.k} aria-pressed="false" class="color-chip btn-active inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold ring-1 ring-slate-200 bg-white text-slate-600 hover:ring-slate-400 transition"><span class="h-3.5 w-3.5 rounded-full ring-1 ring-black/10" style={`background:${c.hex}`}></span>{c.k}</button>
              ))}
              <button type="button" id="custom-chip" aria-pressed="false" class="btn-active inline-flex items-center gap-2 rounded-full px-3 py-2 text-sm font-bold ring-1 ring-dashed ring-slate-300 bg-white text-slate-600 hover:ring-slate-400 transition"><span id="custom-dot" class="h-3.5 w-3.5 rounded-full ring-1 ring-black/10" style="background:#0158FE"></span><span data-site="pages.order_f_custom">Custom</span></button>
            </div>
          </fieldset>
          <label class="text-sm font-bold"><span data-site="pages.order_f_notes">References / things to avoid</span><textarea id="f-notes" rows="3" data-site-ph="pages.order_ph_notes" class="mt-1 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm font-normal" placeholder="Links you love, styles to avoid…"></textarea></label>
        </div>
        <button id="to-2" type="button" data-site="pages.order_review" class="btn-active mt-6 w-full rounded-full bg-primary px-6 py-3.5 text-sm font-bold text-white hover:bg-primary-hover">Review my brief →</button>
      </div>
      <!-- STEP 2 -->
      <div id="os-2" class="hidden">
        <h2 class="text-xl font-extrabold" data-site="pages.order_review_title">Review your order</h2>
        <dl id="os-summary" class="mt-4 space-y-2 text-sm"></dl>
        <div class="mt-6 flex gap-3">
          <button id="back-1" type="button" data-site="pages.order_back" class="btn-active rounded-full bg-white px-6 py-3 text-sm font-bold ring-1 ring-slate-300">← Back</button>
          <button id="to-3" type="button" data-site="pages.order_continue" class="btn-active flex-1 rounded-full bg-dark px-6 py-3 text-sm font-bold text-white hover:bg-slate-800">Continue to send →</button>
        </div>
      </div>
      <!-- STEP 3 -->
      <div id="os-3" class="hidden text-center">
        <h2 class="text-xl font-extrabold" data-site="pages.order_send_title">Send your order</h2>
        <p id="os-total" class="tabular mt-2 text-4xl font-extrabold"></p>
        <p class="mt-1 text-sm text-slate-500" data-site="pages.order_send_sub">Pick how to send — your brief arrives neatly formatted. 100% money-back guarantee.</p>
        <p id="os-error" class="mt-3 hidden text-sm font-bold text-amber-600"></p>
        <div class="mt-6 grid gap-3">
          <a id="send-wa" href="#" target="_blank" rel="noopener" data-site="pages.order_wa" class="btn-active btn-shine rounded-full bg-[#25D366] px-6 py-3.5 text-sm font-bold text-white hover:brightness-95">Send via WhatsApp →</a>
          <a id="send-mail" href="#" data-site="pages.order_mail" class="btn-active rounded-full bg-dark px-6 py-3.5 text-sm font-bold text-white hover:bg-slate-800">Send via Email →</a>
          <button id="back-2" type="button" data-site="pages.order_back" class="btn-active rounded-full bg-white px-6 py-3 text-sm font-bold ring-1 ring-slate-300">← Back</button>
        </div>
      </div>
    </div>
    <!-- COLOR PICKER MODAL (ala Canva: kotak SV + slider hue + hex) -->
    <div id="cp-modal" class="hidden fixed inset-0 z-[80] items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="Custom color">
      <div id="cp-backdrop" class="absolute inset-0 bg-slate-950/50"></div>
      <div class="cp-panel relative w-full max-w-sm rounded-2xl bg-white p-5 shadow-2xl" style="border-radius:20px">
        <h3 class="font-extrabold" data-site="pages.order_cp_title">Pick a custom color</h3>
        <div id="cp-sv" class="relative mt-3 h-44 w-full rounded-xl cursor-crosshair touch-none ring-1 ring-black/10" style="background:hsl(222,100%,50%)">
          <span id="cp-cursor" class="absolute h-5 w-5 -ml-2.5 -mt-2.5 rounded-full border-[3px] border-white shadow pointer-events-none" style="left:100%;top:0%"></span>
        </div>
        <input id="cp-hue" type="range" min="0" max="360" step="1" value="222" class="cp-hue mt-4 w-full" aria-label="Hue" />
        <div class="mt-3 flex items-center gap-3">
          <span id="cp-preview" class="h-10 w-10 shrink-0 rounded-full ring-1 ring-black/10" style="background:#0158FE"></span>
          <label class="flex-1 text-sm font-bold">HEX<input id="cp-hex" maxlength="7" spellcheck="false" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 font-mono text-sm font-normal uppercase" value="#0158FE" /></label>
        </div>
        <div class="mt-4 flex gap-2">
          <button id="cp-remove" type="button" class="btn-active hidden rounded-full px-4 py-2.5 text-sm font-bold text-red-600 hover:bg-red-50" data-site="pages.order_cp_remove">Remove</button>
          <span class="flex-1"></span>
          <button id="cp-cancel" type="button" class="btn-active rounded-full bg-white px-5 py-2.5 text-sm font-bold ring-1 ring-slate-300" data-site="pages.order_cp_cancel">Cancel</button>
          <button id="cp-use" type="button" class="btn-active rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-white hover:bg-primary-hover" data-site="pages.order_cp_use">Use this color</button>
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <script define:vars={{ initialKey: (FALLBACK_PLANS[q] ? q : 'professional'), initialPrice: initial.price, initialName: initial.name, apiBase: apiBase, waNumberFallback: waNumberFallback, orderEmailFallback: orderEmailFallback }}>
    (function () {
      // Kamus halaman dari admin (pages.*); fallback Inggris bila API mati.
      var SITE = {};
      function S(key, fb) {
        var v = (SITE.pages || {})[key];
        return typeof v === 'string' && v !== '' ? v : fb;
      }
      var waNumber = typeof waNumberFallback !== 'undefined' ? waNumberFallback : '6281241525485';
      var orderEmail = typeof orderEmailFallback !== 'undefined' ? orderEmailFallback : 'hello@logopulse.co';
      var plan = initialKey, price = initialPrice, pname = initialName;
      var base = (typeof apiBase !== 'undefined' && apiBase) ? apiBase : 'http://localhost:8080/api/v1';
      try {
        fetch(base + '/settings', { cache: 'no-store' }).then(function (r) {
          return r.ok ? r.json() : null;
        }).then(function (j) {
          var d = (j && (j.data || j)) || {};
          SITE = d;
          if (d.contact && typeof d.contact.wa_number === 'string' && d.contact.wa_number !== '') waNumber = d.contact.wa_number;
          if (d.contact && typeof d.contact.order_email === 'string' && d.contact.order_email !== '') orderEmail = d.contact.order_email;
          var tiers = d.pricing && Array.isArray(d.pricing.tiers) ? d.pricing.tiers : null;
          if (tiers && tiers.length > 0) renderPlans(tiers);
        }).catch(function () {});
      } catch (e) {}
      function fmtUSD(cents) {
        var usd = Number(cents) / 100;
        return '$' + (Number.isInteger(usd) ? String(usd) : usd.toFixed(2));
      }
      function renderPlans(tiers) {
        var grid = document.getElementById('plan-grid');
        if (!grid) return;
        var q = '';
        try { q = (new URLSearchParams(window.location.search).get('plan') || 'professional').toLowerCase(); } catch (e) {}
        grid.innerHTML = '';
        tiers.forEach(function (t) {
          var key = t.id, dollars = fmtUSD(t.price_cents);
          var b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('data-plan', key);
          b.setAttribute('data-price', String(Number(t.price_cents) / 100));
          var on = key === q;
          b.className = 'plan-btn btn-active rounded-2xl px-4 py-4 text-left ring-2 transition ' + (on ? 'ring-primary bg-subtle/50' : 'ring-slate-200');
          var s1 = document.createElement('span');
          s1.className = 'block font-extrabold';
          s1.textContent = t.name;
          var s2 = document.createElement('span');
          s2.className = 'tabular text-2xl font-extrabold';
          s2.textContent = dollars;
          b.appendChild(s1); b.appendChild(s2);
          b.addEventListener('click', function () { selectPlan(key, Number(t.price_cents) / 100, t.name); });
          grid.appendChild(b);
          if (on) { plan = key; price = Number(t.price_cents) / 100; pname = t.name; }
        });
        paintPlans();
      }
      function paintPlans() {
        document.querySelectorAll('.plan-btn').forEach(function (x) {
          var on = x.getAttribute('data-plan') === plan;
          x.classList.toggle('ring-primary', on);
          x.classList.toggle('bg-subtle/50', on);
          x.classList.toggle('ring-slate-200', !on);
        });
      }
      function selectPlan(key, pr, name) {
        plan = key; price = pr; pname = name;
        paintPlans();
      }
      var vibes = [], colors = [], customOn = false;
      var s1 = document.getElementById('os-1'), s2 = document.getElementById('os-2'), s3 = document.getElementById('os-3');
      var dots = Array.from(document.querySelectorAll('#order-steps li'));
      function show(n) {
        if (s1) s1.classList.toggle('hidden', n !== 1);
        if (s2) s2.classList.toggle('hidden', n !== 2);
        if (s3) s3.classList.toggle('hidden', n !== 3);
        dots.forEach(function (d) {
          var on = Number(d.getAttribute('data-step')) <= n;
          d.className = 'rounded-full px-4 py-2 ' + (on ? 'bg-dark text-white' : 'bg-slate-100 text-slate-500');
        });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      function currentStep() {
        if (s2 && !s2.classList.contains('hidden')) return 2;
        if (s3 && !s3.classList.contains('hidden')) return 3;
        return 1;
      }
      document.querySelectorAll('.plan-btn').forEach(function (b) {
        b.addEventListener('click', function () {
          selectPlan(b.getAttribute('data-plan') || plan, Number(b.getAttribute('data-price')) || price, (b.querySelector('span') || {}).textContent || pname);
        });
      });
      function paintChip(btn, on) {
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.classList.toggle('ring-primary', on);
        btn.classList.toggle('bg-subtle/60', on);
        btn.classList.toggle('text-primary', on);
        btn.classList.toggle('ring-slate-200', !on);
        btn.classList.toggle('bg-white', !on);
        btn.classList.toggle('text-slate-600', !on);
      }
      document.querySelectorAll('.vibe-chip').forEach(function (b) {
        b.addEventListener('click', function () {
          var k = b.getAttribute('data-vibe');
          var at = vibes.indexOf(k);
          if (at >= 0) { vibes.splice(at, 1); paintChip(b, false); }
          else if (vibes.length < 3) { vibes.push(k); paintChip(b, true); }
        });
      });
      document.querySelectorAll('.color-chip').forEach(function (b) {
        b.addEventListener('click', function () {
          var k = b.getAttribute('data-color');
          var at = colors.indexOf(k);
          if (at >= 0) { colors.splice(at, 1); paintChip(b, false); }
          else { colors.push(k); paintChip(b, true); }
        });
      });
      var customChip = document.getElementById('custom-chip');
      var customDot = document.getElementById('custom-dot');
      var customHex = '#0158FE';
      var cpModal = document.getElementById('cp-modal');
      var cpSV = document.getElementById('cp-sv');
      var cpCursor = document.getElementById('cp-cursor');
      var cpHue = document.getElementById('cp-hue');
      var cpHex = document.getElementById('cp-hex');
      var cpPreview = document.getElementById('cp-preview');
      var cpRemove = document.getElementById('cp-remove');
      var hsv = { h: 222, s: 1, v: 1 };
      function hsvToHex(h, s, v) {
        h = ((h % 360) + 360) % 360;
        var c = v * s, x = c * (1 - Math.abs(((h / 60) % 2) - 1)), m = v - c, r = 0, g = 0, b = 0;
        if (h < 60) { r = c; g = x; } else if (h < 120) { r = x; g = c; }
        else if (h < 180) { g = c; b = x; } else if (h < 240) { g = x; b = c; }
        else if (h < 300) { r = x; b = c; } else { r = c; b = x; }
        function hx(n) { var s2 = Math.round((n + m) * 255).toString(16); return s2.length < 2 ? '0' + s2 : s2; }
        return ('#' + hx(r) + hx(g) + hx(b)).toUpperCase();
      }
      function hexToHsv(hex) {
        var m = /^#?([0-9a-f]{6})$/i.exec(String(hex).trim());
        if (!m) return null;
        var r = parseInt(m[1].slice(0, 2), 16) / 255, g = parseInt(m[1].slice(2, 4), 16) / 255, b = parseInt(m[1].slice(4, 6), 16) / 255;
        var mx = Math.max(r, g, b), mn = Math.min(r, g, b), d = mx - mn, h = 0;
        if (d) { if (mx === r) h = ((g - b) / d) % 6; else if (mx === g) h = (b - r) / d + 2; else h = (r - g) / d + 4; h *= 60; if (h < 0) h += 360; }
        return { h: h, s: mx === 0 ? 0 : d / mx, v: mx };
      }
      function paintPicker() {
        var hex = hsvToHex(hsv.h, hsv.s, hsv.v);
        if (cpSV) cpSV.style.background = 'linear-gradient(to top, #000, rgba(0,0,0,0)), linear-gradient(to right, #fff, rgba(255,255,255,0)), hsl(' + Math.round(hsv.h) + ',100%,50%)';
        if (cpCursor) { cpCursor.style.left = (hsv.s * 100) + '%'; cpCursor.style.top = ((1 - hsv.v) * 100) + '%'; }
        if (cpPreview) cpPreview.style.background = hex;
        if (cpHex && document.activeElement !== cpHex) cpHex.value = hex;
        if (cpHue && Number(cpHue.value) !== Math.round(hsv.h)) cpHue.value = String(Math.round(hsv.h));
      }
      function openPicker() {
        var cur = hexToHsv(customHex);
        if (cur) hsv = cur;
        paintPicker();
        if (cpRemove) cpRemove.classList.toggle('hidden', !customOn);
        if (cpModal) cpModal.classList.add('open');
      }
      function closePicker() { if (cpModal) cpModal.classList.remove('open'); }
      function svSet(ev) {
        if (!cpSV) return;
        var r = cpSV.getBoundingClientRect();
        var x = (ev.clientX - r.left) / r.width, y = (ev.clientY - r.top) / r.height;
        hsv.s = Math.min(1, Math.max(0, x));
        hsv.v = 1 - Math.min(1, Math.max(0, y));
        paintPicker();
      }
      var svDown = false;
      if (cpSV) {
        cpSV.addEventListener('pointerdown', function (e) { svDown = true; if (cpSV.setPointerCapture && e.pointerId !== undefined) { try { cpSV.setPointerCapture(e.pointerId); } catch (err) {} } svSet(e); });
        cpSV.addEventListener('pointermove', function (e) { if (svDown) svSet(e); });
        cpSV.addEventListener('pointerup', function () { svDown = false; });
        cpSV.addEventListener('pointercancel', function () { svDown = false; });
      }
      if (cpHue) cpHue.addEventListener('input', function () { hsv.h = Number(cpHue.value) || 0; paintPicker(); });
      if (cpHex) cpHex.addEventListener('change', function () {
        var c = hexToHsv(cpHex.value);
        if (c) hsv = c;
        paintPicker();
      });
      var cpCancel = document.getElementById('cp-cancel');
      if (cpCancel) cpCancel.addEventListener('click', closePicker);
      var cpBackdrop = document.getElementById('cp-backdrop');
      if (cpBackdrop) cpBackdrop.addEventListener('click', closePicker);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePicker(); });
      var cpUse = document.getElementById('cp-use');
      if (cpUse) cpUse.addEventListener('click', function () {
        customHex = hsvToHex(hsv.h, hsv.s, hsv.v);
        customOn = true;
        if (customDot) customDot.style.background = customHex;
        if (customChip) paintChip(customChip, true);
        closePicker();
      });
      if (cpRemove) cpRemove.addEventListener('click', function () {
        customOn = false;
        if (customChip) paintChip(customChip, false);
        closePicker();
      });
      if (customChip) customChip.addEventListener('click', function () {
        if (customOn) { customOn = false; paintChip(customChip, false); }
        else openPicker();
      });
      function vibeLabels() { return vibes.slice(); }
      function colorLabels() {
        var out = colors.slice();
        if (customOn) out.push(customHex.toUpperCase());
        return out;
      }
      function val(id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; }
      function row(k, v) { return '<div class="flex justify-between gap-4 rounded-xl bg-slate-50 px-4 py-2.5"><dt class="font-bold">' + k + '</dt><dd class="text-right text-slate-600">' + v + '</dd></div>'; }
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
      function renderSummary() {
        var sum = document.getElementById('os-summary');
        if (!sum || currentStep() !== 2) return;
        sum.innerHTML =
          row(esc(S('pages.order_r_plan', 'Plan')), esc(pname) + ' — $' + price) +
          row(esc(S('pages.order_r_name', 'Name')), esc(val('f-name')) || '—') +
          row(esc(S('pages.order_r_biz', 'Company')), esc(val('f-business')) || '—') +
          row(esc(S('pages.order_r_ind', 'Industry')), esc(val('f-industry')) || '—') +
          row(esc(S('pages.order_r_target', 'Target')), esc(val('f-target')) || '—') +
          row(esc(S('pages.order_r_vibe', 'Vibe')), esc(vibeLabels().join(', ')) || '—') +
          row(esc(S('pages.order_r_color', 'Colors')), esc(colorLabels().join(', ')) || '—') +
          row(esc(S('pages.order_r_contact', 'Contact')), esc(val('f-contact')) || '—') +
          row(esc(S('pages.order_r_notes', 'References')), esc(val('f-notes')) || '—');
      }
      var to2 = document.getElementById('to-2');
      if (to2) to2.addEventListener('click', function () {
        if (!val('f-name') || !val('f-business')) {
          alert(S('pages.order_alert', 'Please fill in your name and company/brand first.'));
          return;
        }
        if (vibes.length < 1) {
          alert(S('pages.order_alert_vibe', 'Pick at least 1 vibe.'));
          return;
        }
        show(2);
        renderSummary();
      });
      var b1 = document.getElementById('back-1'); if (b1) b1.addEventListener('click', function () { show(1); });
      var b2 = document.getElementById('back-2'); if (b2) b2.addEventListener('click', function () { show(2); });
      var t3 = document.getElementById('to-3');
      if (t3) t3.addEventListener('click', function () {
        var t = document.getElementById('os-total'); if (t) t.textContent = '$' + price + ' · ' + pname;
        var lines = [
          S('pages.wa_greet', 'Hello LogoPulse! I want to order a logo:') + '%0A%0A',
          '• ' + S('pages.wa_name', 'Name') + ': ' + encodeURIComponent(val('f-name')) + '%0A',
          '• ' + S('pages.wa_biz', 'Company') + ': ' + encodeURIComponent(val('f-business')) + '%0A',
          '• ' + S('pages.wa_plan', 'Plan') + ': ' + encodeURIComponent(pname + ' ($' + price + ')') + '%0A',
          '• ' + S('pages.wa_ind', 'Industry') + ': ' + encodeURIComponent(val('f-industry') || '-') + '%0A',
          '• ' + S('pages.wa_target', 'Target') + ': ' + encodeURIComponent(val('f-target') || '-') + '%0A',
          '• ' + S('pages.wa_vibe', 'Vibe') + ': ' + encodeURIComponent(vibeLabels().join(', ') || '-') + '%0A',
          '• ' + S('pages.wa_color', 'Colors') + ': ' + encodeURIComponent(colorLabels().join(', ') || '-') + '%0A',
          '• ' + S('pages.wa_contact', 'Contact') + ': ' + encodeURIComponent(val('f-contact') || '-') + '%0A',
          '• ' + S('pages.wa_notes', 'References') + ': ' + encodeURIComponent(val('f-notes') || '-'),
        ];
        var msg = lines.join('');
        var wa = document.getElementById('send-wa');
        if (wa) wa.setAttribute('href', 'https://wa.me/' + waNumber + '?text=' + msg);
        var mail = document.getElementById('send-mail');
        if (mail) mail.setAttribute('href',
          'mailto:' + orderEmail + '?subject=' + encodeURIComponent(S('pages.mail_subj', 'Logo order') + ' ' + pname + ' — ' + val('f-business')) +
          '&body=' + msg.replace(/%0A/g, '\r\n'));
        try {
          fetch(base + '/orders', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ plan: plan, name: val('f-name'), business: val('f-business'), industry: val('f-industry'), target: val('f-target'), vibes: vibes, colors: colorLabels(), notes: val('f-notes'), email: val('f-contact') }),
          }).catch(function () {});
        } catch (e) {}
        show(3);
      });
    })();
  </script>
</BaseLayout>
