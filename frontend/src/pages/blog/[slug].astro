---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { FALLBACK_POSTS } from '../../lib/api';

const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080/api/v1';

export async function getStaticPaths() {
  const base = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080/api/v1';
  const slugs = new Set(FALLBACK_POSTS.map((p) => p.slug));
  try {
    const r = await fetch(`${base}/blog?limit=100`);
    if (r.ok) {
      const j = await r.json();
      for (const p of j?.data ?? []) if (p?.slug) slugs.add(String(p.slug));
    }
  } catch { /* build offline — fallback slugs */ }
  return [...slugs].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const fb = FALLBACK_POSTS.find((p) => p.slug === slug) ?? FALLBACK_POSTS[0];
let post: any = null;
try {
  const r = await fetch(`${API}/blog/${slug}`);
  if (r.ok) post = (await r.json())?.data ?? null;
} catch { /* fallback ke statis */ }

const title = post?.meta_title || post?.title || fb.title;
const desc = post?.meta_description || post?.content?.slice(0, 160) || fb.excerpt;
const cover = post?.thumbnail_url || fb.cover;
const date = (post?.published_at || post?.created_at || fb.date || '').slice(0, 10);
const body = post?.content || '';
---
<BaseLayout title={`${title} — LogoPulse Blog`} description={desc}>
  <Navbar />
  <main class="mx-auto max-w-3xl px-5 pt-32 pb-20">
    <p id="post-date" class="text-xs font-semibold text-slate-400">{date}</p>
    <h1 id="post-title" class="mt-2 text-4xl font-extrabold tracking-tight">{post?.title || fb.title}</h1>
    {cover && <img id="post-cover" src={cover} alt={title} class="mt-6 w-full object-cover" style="border-radius:16px" />}
    <div id="post-body" class="mt-6 text-slate-700 leading-relaxed [&_h1]:text-3xl [&_h1]:font-extrabold [&_h1]:mt-8 [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:mt-8 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-6 [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_a]:text-primary [&_a]:underline [&_blockquote]:border-l-4 [&_blockquote]:border-slate-200 [&_blockquote]:pl-4 [&_blockquote]:italic [&_img]:rounded-2xl [&_img]:my-6 [&_code]:rounded [&_code]:bg-slate-100 [&_code]:px-1.5 [&_code]:py-0.5 [&_pre]:rounded-2xl [&_pre]:bg-slate-900 [&_pre]:text-slate-100 [&_pre]:p-5 [&_pre]:my-6 [&_pre]:overflow-x-auto [&_pre_code]:bg-transparent">
      <p class="text-lg">{fb.excerpt}</p>
      <p class="mt-4">Good branding is a growth lever, not decoration. A clear, memorable mark raises perceived value, builds trust in seconds, and compounds across every touchpoint — your site, packaging, ads, and pitch deck. If your current logo was a placeholder, this is the cheapest high-ROI upgrade on your roadmap.</p>
    </div>
    <a href="/order?plan=professional" class="btn-active mt-8 inline-block rounded-full bg-primary px-6 py-3 text-sm font-bold text-white hover:bg-primary-hover">Get my logo — from $49</a>
  </main>
  <Footer />
  <script define:vars={{ slug, md: body }}>
    import { marked } from 'marked';
    (function () {
      function render(mdText) {
        try {
          var el = document.getElementById('post-body');
          if (el && mdText) el.innerHTML = marked.parse(mdText, { breaks: true });
        } catch (e) {}
      }
      if (md) { render(md); return; }
      // SSR tanpa API (build offline): ambil langsung dari API saat online.
      var base = (window.__lpApiBase || 'http://localhost:8080/api/v1');
      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      fetch(base + '/blog/' + encodeURIComponent(slug), { cache: 'no-store' }).then(function (r) {
        return r.ok ? r.json() : null;
      }).then(function (j) {
        var p = (j && (j.data || j)) || null;
        if (!p) return;
        if (p.title) {
          document.getElementById('post-title').textContent = p.title;
          document.title = p.title + ' — LogoPulse Blog';
        }
        if (p.published_at || p.created_at) {
          document.getElementById('post-date').textContent = String(p.published_at || p.created_at).slice(0, 10);
        }
        if (p.thumbnail_url) {
          var img = document.getElementById('post-cover');
          if (img) { img.src = p.thumbnail_url; img.alt = p.title || ''; }
        }
        var meta = document.querySelector('meta[name="description"]');
        if (meta && (p.meta_description || p.content)) meta.setAttribute('content', p.meta_description || String(p.content).slice(0, 160));
        if (p.content) render(p.content);
        else if (p.meta_description) document.getElementById('post-body').innerHTML = '<p class="text-lg">' + esc(p.meta_description) + '</p>';
      }).catch(function () {});
    })();
  </script>
</BaseLayout>
