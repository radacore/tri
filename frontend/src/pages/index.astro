---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ClientLogos from '../components/ClientLogos.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import PricingTable from '../components/PricingTable.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQ from '../components/FAQ.astro';
import CTABanner from '../components/CTABanner.astro';
import Footer from '../components/Footer.astro';
import { FALLBACK_CASES } from '../lib/api';
---
<BaseLayout>
  <Navbar />
  <main>
    <!-- 01 / HERO -->
    <Hero />
    <!-- 02 / CLIENT LOGOS -->
    <ClientLogos />
    <!-- 03 / CASE STUDIES -->
    <section id="case-studies" class="reveal mx-auto max-w-content px-5 py-16 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary" data-site="sections.cases_kicker">Case studies</p>
          <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight" data-site="sections.cases_title">Logos that moved the numbers</h2>
        </div>
        <a href="/case-studies" data-site="sections.cases_all" class="btn-active rounded-full bg-white px-5 py-2.5 text-sm font-bold ring-1 ring-slate-200 hover:ring-primary hover:text-primary">All case studies →</a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
        {FALLBACK_CASES.map((c, i) => (
          <CaseStudyCard index={i} slug={c.slug} title={c.title} client={c.client} industry={c.industry} result={c.result} mockup={c.mockup} logo={c.logo} excerpt={c.excerpt} />
        ))}
      </div>
    </section>
    <!-- 05 / PORTFOLIO -->
    <div id="portfolio" class="reveal"><PortfolioGrid /></div>
    <!-- 06 / HOW IT WORKS -->
    <div id="how-it-works" class="reveal"><HowItWorks /></div>
    <!-- 07 / PRICING -->
    <div id="pricing" class="reveal"><PricingTable /></div>
    <!-- 08 / TESTIMONIALS -->
    <section id="testimonials" class="reveal pt-12 pb-4 text-center">
      <div class="mx-auto max-w-content px-5">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary" data-site="sections.rev_kicker">Reviews</p>
      <h2 class="mt-2 text-2xl sm:text-4xl font-extrabold tracking-tight" data-site="sections.rev_title">Loved by founders worldwide</h2>
      <p class="mt-2 sm:mt-3 text-sm sm:text-base text-slate-500" data-site="sections.rev_sub">★ 4.9 average across 500+ verified orders</p>
      </div>
    </section>
    <TestimonialCard />
    <!-- 10 / FAQ -->
    <div id="faq" class="reveal"><FAQ /></div>
    <!-- 11 / CTA -->
    <CTABanner />
    <!-- 12 / FOOTER -->
    <Footer />
  </main>
</BaseLayout>
