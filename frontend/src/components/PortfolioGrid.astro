---
import { FALLBACK_PORTFOLIO } from '../lib/api';
const filters = ['All', 'Tech', 'F&B', 'Fashion', 'Health'];
// Ukuran bento diacak di browser setiap refresh (lihat <script> shuffle);
// pola dasar L=4u, W=2u, T=2u, S=1u agar selalu menutup rapat.
const PILL_BASE = 'pf-btn btn-active rounded-full px-4 py-2 text-sm font-bold border transition';
const PILL_ON = 'bg-black text-white border-black';
const PILL_OFF = 'border-gray-300 text-gray-700 hover:bg-gray-100 bg-white';
---
<section class="reveal mx-auto max-w-content px-5 py-16 sm:py-20">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs sm:text-sm font-semibold uppercase tracking-wide text-slate-500" data-site="sections.pf_kicker">Portfolio</p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight" data-site="sections.pf_title">Fresh work, shipped weekly</h2>
    </div>
    <div id="pf-filters" class="flex flex-wrap gap-2" role="tablist" aria-label="Filter portfolio">
      {filters.map((f, i) => (
        <button
          type="button"
          data-filter={f}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class={`${PILL_BASE} ${i === 0 ? PILL_ON : PILL_OFF}`}
        >{f === 'All' ? <span>All</span> : f}</button>
      ))}
    </div>
  </div>
  <div id="pf-grid" class="no-scrollbar relative -mx-5 mt-8 flex snap-x gap-4 overflow-x-auto px-5 pb-2 sm:mx-0 sm:gap-5 sm:px-0 sm:pb-0 md:grid md:grid-cols-2 md:overflow-visible lg:grid-cols-4 [grid-auto-flow:dense]">
    {FALLBACK_PORTFOLIO.slice(0, 6).map((p) => (
      <button type="button" data-category={p.category} data-full={p.image} data-title={p.title} class="pf-item group relative w-[46%] shrink-0 snap-start overflow-hidden rounded-2xl text-left sm:rounded-3xl md:w-auto">
        <img src={p.image} alt={p.title} loading="lazy" decoding="async" width="600" height="450" class="aspect-[4/3] h-full w-full object-cover transition-all duration-300 group-hover:scale-105" />
          <span class="pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-black/50 to-transparent" aria-hidden="true"></span>
          <span class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/60 to-transparent" aria-hidden="true"></span>
          <span class="absolute left-4 top-4 rounded-full bg-black/50 backdrop-blur-md text-white text-xs px-3 py-1 font-semibold">{p.category}</span>
          <span class="absolute bottom-4 left-4 right-4 text-white font-medium text-base md:text-lg leading-snug">{p.title}</span>
        </button>
      ))}
  </div>
  <div class="mt-8 text-center">
    <a href="/portfolio" class="btn-active inline-block rounded-full bg-dark px-8 py-3.5 text-sm font-bold text-white hover:bg-slate-800">View all work →</a>
  </div>
  <dialog id="pf-lightbox" class="rounded-2xl p-0 backdrop:bg-slate-950/70 max-w-3xl w-[calc(100%-2rem)]">
    <div class="relative">
      <img id="pf-lightbox-img" src="" alt="" class="w-full rounded-t-2xl object-cover" />
      <p id="pf-lightbox-cap" class="p-4 font-bold"></p>
      <button id="pf-lightbox-close" type="button" aria-label="Close" class="btn-active absolute right-3 top-3 rounded-full bg-dark/80 px-4 py-2 text-sm font-bold text-white">✕</button>
    </div>
  </dialog>
</section>
<script define:vars={{ pillBase: PILL_BASE, pillOn: PILL_ON, pillOff: PILL_OFF }}>
  (function () {
    var btns = Array.from(document.querySelectorAll('.pf-btn'));
    var items = Array.from(document.querySelectorAll('.pf-item'));
    var grid = document.getElementById('pf-grid');
    // Acak susunan bento setiap refresh: kocok multiset ukuran (total 16
    // unit = 4 baris penuh) lalu tempelkan ke kartu.
    var CLS = {
      l: ['md:col-span-2', 'md:row-span-2'],
      w: ['md:col-span-2'],
      t: ['md:row-span-2'],
      s: []
    };
    var ASP = {
      l: 'aspect-square',
      w: 'aspect-[16/9]',
      t: 'aspect-[3/4]',
      s: 'aspect-[4/3]'
    };
    var ASPECTS = ['aspect-square', 'aspect-[16/9]', 'aspect-[3/4]', 'aspect-[4/3]'];
    var SPANS = ['md:col-span-2', 'md:row-span-2'];
    function shuffle() {
      // Homepage (6 item): multiset W,W,S,S,S,S = 8 sel = 2 baris penuh.
      // Selalu pas tanpa lubang di susunan apapun (dense flow).
      var deck = ['w', 'w', 's', 's', 's', 's'];
      for (var k = deck.length - 1; k > 0; k--) {
        var r = Math.floor(Math.random() * (k + 1));
        var tmp = deck[k]; deck[k] = deck[r]; deck[r] = tmp;
      }
      items.forEach(function (it, idx) {
        var s = deck[idx % deck.length];
        var img = it.querySelector('img');
        SPANS.forEach(function (c) { it.classList.remove(c); });
        CLS[s].forEach(function (c) { it.classList.add(c); });
        if (img) {
          ASPECTS.forEach(function (c) { img.classList.remove(c); });
          img.classList.add(ASP[s]);
        }
      });
    }
    shuffle();
    // Filter pills dari admin (/categories); gagal = pakai bawaan HTML.
    try {
      var base = (window.__lpApiBase || 'http://localhost:8080/api/v1');
      fetch(base + '/categories', { cache: 'no-store' }).then(function (r) {
        return r.ok ? r.json() : null;
      }).then(function (j) {
        var list = (j && (j.data || j)) || [];
        if (!Array.isArray(list) || list.length === 0) return;
        var wrap = document.getElementById('pf-filters');
        if (!wrap) return;
        var names = ['All'].concat(list.map(function (c) { return c.name; }));
        wrap.innerHTML = '';
        names.forEach(function (name, i) {
          var b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('data-filter', name);
          b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
          b.className = pillBase + ' ' + (i === 0 ? pillOn : pillOff);
          b.textContent = name;
          b.addEventListener('click', function () { selectFilter(name); });
          wrap.appendChild(b);
        });
        btns = Array.from(wrap.querySelectorAll('.pf-btn'));
      }).catch(function () {});
    } catch (e) {}
    function selectFilter(f) {
      paint(f);
      if (grid) grid.classList.toggle('pf-uniform', f !== 'All');
      items.forEach(function (it) {
        var show = f === 'All' || it.getAttribute('data-category') === f;
        it.classList.toggle('pf-hidden', !show);
      });
    }
    function paint(active) {
      btns.forEach(function (b) {
        var on = b.getAttribute('data-filter') === active;
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.className = pillBase + ' ' + (on ? pillOn : pillOff);
      });
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        selectFilter(b.getAttribute('data-filter') || 'All');
      });
    });
    var dlg = document.getElementById('pf-lightbox');
    var img = document.getElementById('pf-lightbox-img');
    var cap = document.getElementById('pf-lightbox-cap');
    items.forEach(function (it) {
      it.addEventListener('click', function () {
        if (img && cap && dlg && typeof dlg.showModal === 'function') {
          img.setAttribute('src', it.getAttribute('data-full') || '');
          img.setAttribute('alt', it.getAttribute('data-title') || '');
          cap.textContent = it.getAttribute('data-title') || '';
          dlg.showModal();
        }
      });
    });
    var close = document.getElementById('pf-lightbox-close');
    if (close && dlg) close.addEventListener('click', function () { dlg.close(); });
  })();
</script>
