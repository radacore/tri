---
import { API } from '../lib/api';
import {
  categoriesFrom,
  portfolioCardHTML,
  type Category,
  type PortfolioCard,
} from '../lib/portfolio';

// Data diambil saat build supaya HTML pertama sudah berisi karya asli dari
// admin (bukan contoh). Script di bawah menyegarkan lagi tanpa rebuild.
let items: PortfolioCard[] = [];
try {
  const r = await fetch(`${API}/portfolio?limit=6`);
  if (r.ok) {
    const j = await r.json();
    const list: PortfolioCard[] = (j?.data ?? j) ?? [];
    if (Array.isArray(list)) items = list.filter((p) => p?.image_url).slice(0, 6);
  }
} catch { /* build offline — section tetap kosong, script mengisi saat runtime */ }

let categories: string[] = [];
try {
  const r = await fetch(`${API}/categories`);
  if (r.ok) {
    const j = await r.json();
    const list: Category[] = (j?.data ?? j) ?? [];
    if (Array.isArray(list)) categories = list.map((c) => String(c.name)).filter(Boolean);
  }
} catch { /* build offline */ }
if (categories.length === 0) categories = categoriesFrom(items);

const filters = ['All', ...categories];
const cards = items
  .map((p, i) => portfolioCardHTML(p, i > 3 ? 'max-md:hidden' : ''))
  .join('');

const PILL_BASE = 'pf-btn btn-active shrink-0 rounded-full border px-3 py-1.5 text-xs font-bold transition sm:px-4 sm:py-2 sm:text-sm';
const PILL_ON = 'bg-black text-white border-black';
const PILL_OFF = 'border-gray-300 text-gray-700 hover:bg-gray-100 bg-white';
---
<section class="reveal mx-auto max-w-content px-5 py-16 sm:py-20">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs sm:text-sm font-semibold uppercase tracking-wide text-slate-500" data-site="sections.pf_kicker">Portfolio</p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight" data-site="sections.pf_title">Fresh work, shipped weekly</h2>
    </div>
    <div id="pf-filters" class="no-scrollbar flex max-w-full flex-nowrap gap-2 overflow-x-auto sm:flex-wrap" role="tablist" aria-label="Filter portfolio">
      {filters.map((f, i) => (
        <button
          type="button"
          data-filter={f}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class={`${PILL_BASE} ${i === 0 ? PILL_ON : PILL_OFF}`}
        >{f === 'All' ? <span>All</span> : f}</button>
      ))}
    </div>
  </div>
  <div id="pf-grid" class="relative mt-8 grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-4 [grid-auto-flow:dense]" set:html={cards}>
  </div>
  <div class="mt-8 text-center">
    <a href="/portfolio" class="btn-active inline-block rounded-full bg-dark px-8 py-3.5 text-sm font-bold text-white hover:bg-slate-800">View all work →</a>
  </div>
  <dialog id="pf-lightbox" class="rounded-2xl p-0 backdrop:bg-slate-950/70 max-w-3xl w-[calc(100%-2rem)]">
    <div class="relative">
      <img id="pf-lightbox-img" src="" alt="" class="w-full rounded-t-2xl object-cover" />
      <p id="pf-lightbox-cap" class="p-4 font-bold"></p>
      <button id="pf-lightbox-close" type="button" aria-label="Close" class="btn-active absolute right-3 top-3 rounded-full bg-dark/80 px-4 py-2 text-sm font-bold text-white">✕</button>
    </div>
  </dialog>
</section>
<script>
  import { categoriesFrom, fetchCategories, fetchPortfolio, portfolioCardHTML } from '../lib/portfolio';

  // Ukuran bento diacak setiap refresh: multiset W,W,S,S,S,S = 8 sel = 2 baris penuh.
  const CLS: Record<string, string[]> = {
    w: ['md:col-span-2'],
    s: [],
  };
  const ASP: Record<string, string> = { w: 'aspect-[16/9]', s: 'aspect-[4/3]' };
  const ASPECTS = ['aspect-square', 'aspect-[16/9]', 'aspect-[3/4]', 'aspect-[4/3]'];
  const SPANS = ['md:col-span-2', 'md:row-span-2'];

  const grid = document.getElementById('pf-grid');
  const dialog = document.getElementById('pf-lightbox') as HTMLDialogElement | null;
  const dialogImg = document.getElementById('pf-lightbox-img') as HTMLImageElement | null;
  const dialogCap = document.getElementById('pf-lightbox-cap');
  const pillBase = 'pf-btn btn-active shrink-0 rounded-full border px-3 py-1.5 text-xs font-bold transition sm:px-4 sm:py-2 sm:text-sm';
  const pillOn = 'bg-black text-white border-black';
  const pillOff = 'border-gray-300 text-gray-700 hover:bg-gray-100 bg-white';

  let cards: HTMLElement[] = [];
  let pills: HTMLButtonElement[] = [];

  function shuffle() {
    const deck = ['w', 'w', 's', 's', 's', 's'];
    for (let i = deck.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [deck[i], deck[j]] = [deck[j], deck[i]];
    }
    cards.forEach((card, idx) => {
      const size = deck[idx % deck.length];
      const img = card.querySelector('img');
      SPANS.forEach((c) => card.classList.remove(c));
      CLS[size].forEach((c) => card.classList.add(c));
      if (img) {
        ASPECTS.forEach((c) => img.classList.remove(c));
        img.classList.add(ASP[size]);
      }
    });
  }

  function paint(active: string) {
    pills.forEach((b) => {
      const on = b.dataset.filter === active;
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
      b.className = `${pillBase} ${on ? pillOn : pillOff}`;
    });
  }

  function selectFilter(name: string) {
    paint(name);
    grid?.classList.toggle('pf-uniform', name !== 'All');
    cards.forEach((card) => {
      const show = name === 'All' || card.dataset.category === name;
      card.classList.toggle('pf-hidden', !show);
    });
  }

  function bindCards() {
    cards = Array.from(document.querySelectorAll<HTMLElement>('#pf-grid .pf-item'));
    shuffle();
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        if (!dialog || !dialogImg || !dialogCap) return;
        dialogImg.src = card.dataset.full || '';
        dialogImg.alt = card.dataset.title || '';
        dialogCap.textContent = card.dataset.title || '';
        dialog.showModal();
      });
    });
  }

  function renderFilters(names: string[]) {
    const wrap = document.getElementById('pf-filters');
    if (!wrap) return;
    wrap.innerHTML = '';
    names.forEach((name, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.filter = name;
      b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
      b.className = `${pillBase} ${i === 0 ? pillOn : pillOff}`;
      b.textContent = name;
      b.addEventListener('click', () => selectFilter(name));
      wrap.appendChild(b);
    });
    pills = Array.from(wrap.querySelectorAll<HTMLButtonElement>('.pf-btn'));
  }

  pills = Array.from(document.querySelectorAll<HTMLButtonElement>('#pf-filters .pf-btn'));
  pills.forEach((b) => b.addEventListener('click', () => selectFilter(b.dataset.filter || 'All')));
  bindCards();
  document.getElementById('pf-lightbox-close')?.addEventListener('click', () => dialog?.close());

  // Segarkan dari API: item baru dari admin muncul tanpa rebuild landing.
  void (async () => {
    const [list, cats] = await Promise.all([fetchPortfolio(6), fetchCategories()]);
    if (list.length > 0 && grid) {
      grid.innerHTML = list
        .map((p, i) => portfolioCardHTML(p, i > 3 ? 'max-md:hidden' : ''))
        .join('');
      bindCards();
    }
    const names = cats.length > 0 ? cats.map((c) => c.name) : categoriesFrom(list);
    if (names.length > 0) renderFilters(['All', ...names]);
  })();
</script>
