---
import { FALLBACK_PORTFOLIO } from '../lib/api';
const filters = ['All', 'Tech', 'F&B', 'Fashion', 'Health'];
// Bento 3 ukuran, pola berulang L M S S — total selalu kelipatan 4 unit.
const SIZES = ['l', 'm', 's', 's', 'l', 'm', 's', 's'] as const;
const SIZE_CLS: Record<string, string> = {
  l: 'col-span-2 row-span-2',
  m: 'col-span-2',
  s: '',
};
---
<section class="reveal mx-auto max-w-content px-5 py-16 sm:py-20">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary" data-site="sections.pf_kicker">Portfolio</p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight" data-site="sections.pf_title">Fresh work, shipped weekly</h2>
    </div>
    <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter portfolio">
      {filters.map((f, i) => (
        <button
          type="button"
          data-filter={f}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class={`pf-btn btn-active rounded-full px-4 py-2 text-sm font-bold ring-1 transition ${i === 0 ? 'bg-dark text-white ring-dark' : 'bg-white text-slate-600 ring-slate-200 hover:ring-slate-400'}`}
        >{f === 'All' ? <span>All</span> : f}</button>
      ))}
    </div>
  </div>
  <div id="pf-grid" class="relative mt-8 grid auto-rows-[150px] grid-cols-2 gap-4 sm:auto-rows-[180px] lg:grid-cols-4 [grid-auto-flow:dense]">
    {FALLBACK_PORTFOLIO.map((p, i) => (
      <button type="button" data-category={p.category} data-full={p.image} data-title={p.title} class={`pf-item group relative overflow-hidden text-left ring-1 ring-slate-900/10 hover:-translate-y-1 hover:shadow-xl transition-all duration-300 hover:[transform:translateY(-4px)] ${SIZE_CLS[SIZES[i % SIZES.length]]}`} style="border-radius:16px">
        <img src={p.image} alt={p.title} loading="lazy" decoding="async" width="600" height="450" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <span class="absolute left-3 top-3 rounded-full bg-black/70 px-2.5 py-1 text-[11px] font-bold text-white backdrop-blur">{p.category}</span>
        <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 via-black/30 to-transparent p-4 pt-10 text-left">
          <span class="block text-sm font-bold text-white sm:text-base">{p.title}</span>
        </span>
      </button>
    ))}
  </div>
  <dialog id="pf-lightbox" class="rounded-2xl p-0 backdrop:bg-slate-950/70 max-w-3xl w-[calc(100%-2rem)]">
    <div class="relative">
      <img id="pf-lightbox-img" src="" alt="" class="w-full rounded-t-2xl object-cover" />
      <p id="pf-lightbox-cap" class="p-4 font-bold"></p>
      <button id="pf-lightbox-close" type="button" aria-label="Close" class="btn-active absolute right-3 top-3 rounded-full bg-dark/80 px-4 py-2 text-sm font-bold text-white">✕</button>
    </div>
  </dialog>
</section>
<script>
  (function () {
    var btns = Array.from(document.querySelectorAll('.pf-btn'));
    var items = Array.from(document.querySelectorAll('.pf-item'));
    function paint(active) {
      btns.forEach(function (b) {
        var on = b.getAttribute('data-filter') === active;
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.className = 'pf-btn btn-active rounded-full px-4 py-2 text-sm font-bold ring-1 transition ' +
          (on ? 'bg-dark text-white ring-dark' : 'bg-white text-slate-600 ring-slate-200 hover:ring-slate-400');
      });
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var f = b.getAttribute('data-filter') || 'All';
        paint(f);
        items.forEach(function (it) {
          var show = f === 'All' || it.getAttribute('data-category') === f;
          it.classList.toggle('pf-hidden', !show);
        });
      });
    });
    var dlg = document.getElementById('pf-lightbox');
    var img = document.getElementById('pf-lightbox-img');
    var cap = document.getElementById('pf-lightbox-cap');
    items.forEach(function (it) {
      it.addEventListener('click', function () {
        if (img && cap && dlg && typeof dlg.showModal === 'function') {
          img.setAttribute('src', it.getAttribute('data-full') || '');
          img.setAttribute('alt', it.getAttribute('data-title') || '');
          cap.textContent = it.getAttribute('data-title') || '';
          dlg.showModal();
        }
      });
    });
    var close = document.getElementById('pf-lightbox-close');
    if (close && dlg) close.addEventListener('click', function () { dlg.close(); });
  })();
</script>
