      <a class="nav-link px-3 py-2 hover:text-white" href="/case-studies">Case Studies</a>
      <a class="nav-link px-3 py-2 hover:text-white" href="/#how-it-works">How</a>
      <a class="nav-link px-3 py-2 hover:text-white" href="/#pricing">Pricing</a>
      <a class="nav-link px-3 py-2 hover:text-white" href="/blog">Blog</a>
    </div>
    <div class="flex items-center gap-2">
      <a href="/#pricing" data-site="nav.cta" class="btn-active hidden rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-white hover:bg-primary-hover min-[810px]:inline-flex">View Pricing</a>
      <button id="nav-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu" class="grid h-10 w-10 place-items-center rounded-full text-white transition hover:bg-white/10 min-[810px]:hidden">
