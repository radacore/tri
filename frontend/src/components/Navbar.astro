<style>
  #nav-menu { transition: opacity .32s ease; }
  #nav-menu .nav-full-link { opacity: 0; transform: translateY(14px); transition: opacity .3s ease, transform .3s ease; }
  #nav-menu .nav-full-link:nth-child(1) { transition-delay: .2s; }
  #nav-menu .nav-full-link:nth-child(2) { transition-delay: .15s; }
  #nav-menu .nav-full-link:nth-child(3) { transition-delay: .1s; }
  #nav-menu .nav-full-link:nth-child(4) { transition-delay: .05s; }
  #nav-menu .nav-full-link:nth-child(5) { transition-delay: 0s; }
  #nav-menu .nav-full-foot { opacity: 0; transform: translateY(10px); transition: opacity .3s ease, transform .3s ease; }
  #nav-menu.menu-open .nav-full-link { opacity: 1; transform: none; }
  #nav-menu.menu-open .nav-full-link:nth-child(1) { transition-delay: .05s; }
  #nav-menu.menu-open .nav-full-link:nth-child(2) { transition-delay: .1s; }
  #nav-menu.menu-open .nav-full-link:nth-child(3) { transition-delay: .15s; }
  #nav-menu.menu-open .nav-full-link:nth-child(4) { transition-delay: .2s; }
  #nav-menu.menu-open .nav-full-link:nth-child(5) { transition-delay: .25s; }
  #nav-menu.menu-open .nav-full-foot { opacity: 1; transform: none; transition-delay: .3s; }
</style>
<script>
  (function () {
    var header = document.getElementById('site-nav');
    if (!header) return;
    var nav = document.getElementById('site-nav-inner');
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var lastY = window.scrollY || 0;
    var HIDE_AFTER = 140;
    var TOLERANCE = 4;
    var ticking = false;
    var menuOpen = false;
    function apply() {
      ticking = false;
      var y = window.scrollY || 0;
      if (!nav) return;
      var shrink = y > 40;
      nav.style.paddingTop = shrink ? '0.5rem' : '';
      nav.style.paddingBottom = shrink ? '0.5rem' : '';
      if (!reduceMotion && !menuOpen) {
        var scrollingDown = y > lastY + TOLERANCE;
        var scrollingUp = y < lastY - TOLERANCE;
        if (scrollingDown && y > HIDE_AFTER) {
          header.classList.add('nav-gone');
        } else if (scrollingUp || y <= HIDE_AFTER) {
          header.classList.remove('nav-gone');
        }
      }
      lastY = y;
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(apply); }
    }, { passive: true });
    apply();
    var burger = document.getElementById('nav-burger');
    var menu = document.getElementById('nav-menu');
    var iconOpen = document.getElementById('nav-burger-open');
    var iconClose = document.getElementById('nav-burger-close');
    var closeTimer = null;
    function setMenu(open) {
      if (!menu || !burger) return;
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      menuOpen = open;
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
      if (iconOpen) iconOpen.classList.toggle('hidden', open);
      if (iconClose) iconClose.classList.toggle('hidden', !open);
      if (open) {
        menu.setAttribute('aria-hidden', 'false');
        menu.classList.remove('invisible');
        menu.classList.remove('pointer-events-none');
        void menu.offsetWidth;
        menu.classList.remove('opacity-0');
        menu.classList.add('menu-open');
      } else {
        menu.setAttribute('aria-hidden', 'true');
        menu.classList.remove('menu-open');
        menu.classList.add('opacity-0');
        menu.classList.add('pointer-events-none');
        var delay = reduceMotion ? 0 : 330;
        closeTimer = setTimeout(function () {
          menu.classList.add('invisible');
          closeTimer = null;
        }, delay);
      }
      document.documentElement.style.overflow = open ? 'hidden' : '';
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) header.classList.remove('nav-gone');
    }
    if (burger) burger.addEventListener('click', function () {
      setMenu(burger.getAttribute('aria-expanded') !== 'true');
    });
    if (menu) menu.addEventListener('click', function (e) {
      if (e.target && e.target.closest('a')) setMenu(false);
    });
    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menuOpen) setMenu(false);
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth >= 810 && menuOpen) setMenu(false);
    });
  })();
</script>
