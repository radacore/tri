---
import { FALLBACK_TESTIMONIALS } from '../lib/api';
---
<section class="mx-auto max-w-content px-5 pb-4">
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {FALLBACK_TESTIMONIALS.map((t, i) => (
      <article class="reveal rounded-2xl bg-white p-6 ring-1 ring-slate-900/10 shadow-sm hover:-translate-y-1 hover:shadow-lg transition-all" style={`--i:${i % 3};border-radius:20px`}>
        <div class="star-pop flex gap-0.5 text-amber-400" style={`--i:${i}`} aria-label={`${t.rating} out of 5 stars`}>★★★★★</div>
        <p class="mt-3 text-[15px] leading-relaxed text-slate-700">“<span data-l="en">{t.quote}</span><span data-l="id" hidden>{t.quoteId ?? t.quote}</span>”</p>
        <div class="mt-4 flex items-center gap-3">
          <img src={t.avatar} alt={t.name} width="40" height="40" loading="lazy" class="h-10 w-10 rounded-full object-cover" />
          <div><p class="text-sm font-bold">{t.name}</p><p class="text-xs text-slate-500">{t.role}</p></div>
        </div>
      </article>
    ))}
  </div>
</section>
