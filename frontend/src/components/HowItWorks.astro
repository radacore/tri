---
const steps = [
  { n: '01', title: 'Brief', text: 'Tell us about your business, style, and competitors in a 5-minute form.' },
  { n: '02', title: 'Concepts', text: 'Get 2–3 original logo concepts within 48 hours. No templates, ever.' },
  { n: '03', title: 'Revisions', text: 'Unlimited-tweak rounds until it feels exactly right (most finish in 1–2).' },
];
const last = { n: '04', title: 'Delivery', text: 'Full brand kit: vector files, colors, fonts, mockups, social pack.' };
---
<section class="reveal bg-slate-50/70 py-16 sm:py-20">
  <div class="mx-auto max-w-content px-5">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary" data-site="sections.how_kicker">How it works</p>
    <h2 class="mt-2 max-w-xl text-3xl sm:text-4xl font-extrabold tracking-tight" data-site="sections.how_title">From brief to brand in 4 steps</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <article class="group overflow-hidden rounded-2xl bg-white ring-1 ring-slate-900/10 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style="border-radius:20px">
        <div class="overflow-hidden bg-[#E2E7F9]">
          <svg viewBox="0 0 600 450" class="aspect-[4/3] w-full" role="img" aria-label="Brief form illustration">
            <rect x="200" y="90" width="200" height="270" rx="16" fill="#FFFFFF" />
            <rect x="230" y="130" width="140" height="18" rx="9" fill="#0158FE" />
            <g class="st-draw" style="animation-delay:.2s"><path d="M230 200h110" stroke="#0158FE" stroke-width="14" stroke-linecap="round" pathLength="1" /></g>
            <g class="st-pop" style="animation-delay:.35s"><circle cx="375" cy="200" r="20" fill="#10B981" /><path d="M367 200l6 6 11-12" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
            <g class="st-draw" style="animation-delay:.5s"><path d="M230 250h90" stroke="#94A3B8" stroke-width="14" stroke-linecap="round" pathLength="1" /></g>
            <g class="st-pop" style="animation-delay:.65s"><circle cx="375" cy="250" r="20" fill="#10B981" /><path d="M367 250l6 6 11-12" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
            <g class="st-draw" style="animation-delay:.8s"><path d="M230 300h100" stroke="#94A3B8" stroke-width="14" stroke-linecap="round" pathLength="1" /></g>
            <g class="st-pop" style="animation-delay:.95s"><circle cx="375" cy="300" r="20" fill="#10B981" /><path d="M367 300l6 6 11-12" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
          </svg>
        </div>
        <div class="p-6">
          <p class="flex items-center gap-3">
            <span class="tabular grid h-9 w-9 place-items-center rounded-full bg-dark text-sm font-extrabold text-white">01</span>
            <h3 class="text-lg font-extrabold" data-site="how_steps.0.t">Brief</h3>
          </p>
          <p class="mt-2 text-sm text-slate-600" data-site="how_steps.0.d">Tell us about your business, style, and competitors in a 5-minute form.</p>
        </div>
      </article>
      <article class="group overflow-hidden rounded-2xl bg-white ring-1 ring-slate-900/10 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style="border-radius:20px">
        <div class="overflow-hidden bg-[#E2E7F9]">
          <svg viewBox="0 0 600 450" class="aspect-[4/3] w-full" role="img" aria-label="Design concepts illustration">
            <circle cx="300" cy="225" r="110" fill="#FFFFFF" />
            <g class="st-draw" style="animation-delay:.2s"><path d="M260 290l70-130 45 22-70 130-32 10z" fill="none" stroke="#0158FE" stroke-width="12" stroke-linejoin="round" pathLength="1" /></g>
            <g class="st-pop" style="animation-delay:.5s"><circle cx="180" cy="150" r="16" fill="#0158FE" opacity="0.35" /></g>
            <g class="st-pop" style="animation-delay:.7s"><circle cx="440" cy="140" r="10" fill="#0158FE" opacity="0.55" /></g>
            <g class="st-pop" style="animation-delay:.9s"><circle cx="430" cy="320" r="16" fill="#0158FE" opacity="0.35" /></g>
            <g class="st-pop" style="animation-delay:1.1s"><circle cx="300" cy="225" r="22" fill="#0158FE" /><path d="M291 225l6 6 12-13" stroke="#fff" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
          </svg>
        </div>
        <div class="p-6">
          <p class="flex items-center gap-3">
            <span class="tabular grid h-9 w-9 place-items-center rounded-full bg-dark text-sm font-extrabold text-white">02</span>
            <h3 class="text-lg font-extrabold" data-site="how_steps.1.t">Concepts</h3>
          </p>
          <p class="mt-2 text-sm text-slate-600" data-site="how_steps.1.d">Get 2–3 original logo concepts within 48 hours. No templates, ever.</p>
        </div>
      </article>
      <article class="group overflow-hidden rounded-2xl bg-white ring-1 ring-slate-900/10 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style="border-radius:20px">
        <div class="overflow-hidden bg-[#E2E7F9]">
          <svg viewBox="0 0 600 450" class="aspect-[4/3] w-full" role="img" aria-label="Revision rounds illustration">
            <g class="st-slide-l" style="animation-delay:.2s">
              <rect x="90" y="90" width="230" height="120" rx="24" fill="#FFFFFF" />
              <rect x="120" y="125" width="130" height="14" rx="7" fill="#CBD5E1" />
              <rect x="120" y="152" width="100" height="14" rx="7" fill="#CBD5E1" />
            </g>
            <g class="st-slide-r" style="animation-delay:.55s">
              <rect x="280" y="230" width="230" height="120" rx="24" fill="#0158FE" />
              <rect x="310" y="265" width="130" height="14" rx="7" fill="#fff" opacity="0.9" />
              <rect x="310" y="292" width="100" height="14" rx="7" fill="#fff" opacity="0.7" />
            </g>
            <g class="st-pop" style="animation-delay:1s"><circle cx="490" cy="120" r="26" fill="#10B981" /><path d="M479 120l8 8 15-16" stroke="#fff" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
          </svg>
        </div>
        <div class="p-6">
          <p class="flex items-center gap-3">
            <span class="tabular grid h-9 w-9 place-items-center rounded-full bg-dark text-sm font-extrabold text-white">03</span>
            <h3 class="text-lg font-extrabold" data-site="how_steps.2.t">Revisions</h3>
          </p>
          <p class="mt-2 text-sm text-slate-600" data-site="how_steps.2.d">Unlimited-tweak rounds until it feels exactly right (most finish in 1–2).</p>
        </div>
      </article>
    </div>
    <article class="group mt-5 grid overflow-hidden rounded-2xl bg-white ring-1 ring-slate-900/10 shadow-sm transition-all duration-300 hover:shadow-xl md:grid-cols-2" style="border-radius:20px">
      <div class="flex flex-col justify-center p-6 sm:p-10">
        <p class="flex items-center gap-3">
          <span class="tabular grid h-9 w-9 place-items-center rounded-full bg-dark text-sm font-extrabold text-white">04</span>
          <h3 class="text-xl sm:text-2xl font-extrabold" data-site="how_steps.3.t">Delivery</h3>
        </p>
        <p class="mt-3 text-slate-600" data-site="how_steps.3.d">Full brand kit: vector files, colors, fonts, mockups, social pack.</p>
        <div class="mt-5">
          <a href="/order?plan=professional" class="btn-active inline-block rounded-full bg-primary px-6 py-3 text-sm font-bold text-white hover:bg-primary-hover">Start my project →</a>
        </div>
      </div>
      <div class="overflow-hidden bg-[#E2E7F9]">
        <svg viewBox="0 0 900 450" class="h-full min-h-[240px] w-full" role="img" aria-label="Delivery illustration" preserveAspectRatio="xMidYMid slice">
          <g class="st-drop" style="animation-delay:.3s">
            <rect x="180" y="90" width="130" height="160" rx="10" fill="#FFFFFF" />
            <circle cx="245" cy="160" r="28" fill="#0158FE" opacity="0.9" />
          </g>
          <g class="st-drop" style="animation-delay:.55s">
            <rect x="330" y="60" width="130" height="160" rx="10" fill="#FFFFFF" />
            <rect x="352" y="120" width="86" height="14" rx="7" fill="#0158FE" opacity="0.7" />
            <rect x="352" y="148" width="60" height="14" rx="7" fill="#94A3B8" />
          </g>
          <rect x="540" y="150" width="240" height="180" rx="16" fill="#0158FE" />
          <rect x="540" y="150" width="240" height="44" rx="16" fill="#013A9E" />
          <rect x="540" y="176" width="240" height="18" fill="#013A9E" />
          <rect x="643" y="150" width="34" height="180" fill="#FFFFFF" opacity="0.85" />
          <rect x="643" y="150" width="34" height="44" fill="#FFFFFF" />
          <g class="st-pop" style="animation-delay:1s">
            <circle cx="810" cy="320" r="40" fill="#10B981" />
            <path d="M792 320l13 13 24-26" stroke="#fff" stroke-width="12" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </g>
        </svg>
      </div>
    </article>
  </div>
</section>
