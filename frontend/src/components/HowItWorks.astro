<script>
  // Sinkronisasi + hemat daya untuk loop SMIL 10 detik.
  (function () {
    var sec = document.getElementById('how-it-works-sec');
    if (!sec) return;
    var btn = document.getElementById('how-cta-btn');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var svgs = Array.from(sec.querySelectorAll('svg.st-smil'));
    function setPaused(p) {
      svgs.forEach(function (s) {
        try { p ? s.pauseAnimations() : s.unpauseAnimations(); } catch (e) {}
      });
      document.body.classList.toggle('st-paused-all', p);
    }
    function syncBtn() {
      if (!btn || reduce) return;
      btn.classList.remove('go');
      void btn.offsetWidth;
      btn.classList.add('go');
    }
    var deliv = document.getElementById('how-svg-4');
    if (deliv) deliv.addEventListener('repeatEvent', syncBtn);
    if (reduce) {
      setPaused(true);
      return;
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          setPaused(!e.isIntersecting);
          if (e.isIntersecting) syncBtn();
        });
      }, { threshold: 0.2 }).observe(sec);
    } else {
      setPaused(false);
      syncBtn();
    }
    document.addEventListener('visibilitychange', function () {
      setPaused(document.hidden);
    });
  })();
</script>
