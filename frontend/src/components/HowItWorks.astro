---
const steps = [
  { n: '01', tk: 'how.s1t', title: 'Brief', dk: 'how.s1d', text: 'Tell us about your business, style, and competitors in a 5-minute form.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 12h6"/><path d="M9 16h4"/></svg>' },
  { n: '02', tk: 'how.s2t', title: 'Concepts', dk: 'how.s2d', text: 'Get 2–3 original logo concepts within 48 hours. No templates, ever.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><circle cx="11" cy="11" r="2"/></svg>' },
  { n: '03', tk: 'how.s3t', title: 'Revisions', dk: 'how.s3d', text: 'Unlimited-tweak rounds until it feels exactly right (most finish in 1–2).',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>' },
  { n: '04', tk: 'how.s4t', title: 'Delivery', dk: 'how.s4d', text: 'Full brand kit: vector files, colors, fonts, mockups, social pack.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>' },
];
---
<section class="reveal bg-slate-50/70 py-16 sm:py-20">
  <div class="mx-auto max-w-content px-5">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary text-center" data-i18n="how.kicker">How it works</p>
    <h2 class="mt-2 text-center text-3xl sm:text-4xl font-extrabold tracking-tight" data-i18n="how.title">From brief to brand in 4 steps</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-4">
      {steps.map((s, i) => (
        <div class="relative rounded-2xl bg-white p-6 ring-1 ring-slate-900/10 shadow-sm" style={`--i:${i};border-radius:20px`}>
          <span class="grid h-11 w-11 place-items-center rounded-full bg-subtle text-primary [&>svg]:h-5 [&>svg]:w-5" aria-hidden="true" set:html={s.icon}></span>
          <p class="mt-4 text-xs font-extrabold tracking-widest text-primary"><span data-i18n="how.step">STEP</span> {s.n}</p>
          <h3 class="mt-1 text-lg font-extrabold" data-i18n={s.tk}>{s.title}</h3>
          <p class="mt-1 text-sm text-slate-600" data-i18n={s.dk}>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
