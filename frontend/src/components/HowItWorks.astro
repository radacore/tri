---
const steps = [
  { n: '01', img: '/steps/step-1.svg', title: 'Brief', text: 'Tell us about your business, style, and competitors in a 5-minute form.' },
  { n: '02', img: '/steps/step-2.svg', title: 'Concepts', text: 'Get 2–3 original logo concepts within 48 hours. No templates, ever.' },
  { n: '03', img: '/steps/step-3.svg', title: 'Revisions', text: 'Unlimited-tweak rounds until it feels exactly right (most finish in 1–2).' },
];
const last = { n: '04', img: '/steps/step-4-wide.svg', title: 'Delivery', text: 'Full brand kit: vector files, colors, fonts, mockups, social pack.' };
---
<section class="reveal bg-slate-50/70 py-16 sm:py-20">
  <div class="mx-auto max-w-content px-5">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary" data-site="sections.how_kicker">How it works</p>
    <h2 class="mt-2 max-w-xl text-3xl sm:text-4xl font-extrabold tracking-tight" data-site="sections.how_title">From brief to brand in 4 steps</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {steps.map((s, i) => (
        <article class="group overflow-hidden rounded-2xl bg-white ring-1 ring-slate-900/10 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style={`--i:${i};border-radius:20px`}>
          <div class="overflow-hidden">
            <img src={s.img} alt="" loading="lazy" decoding="async" width="600" height="450" class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <div class="p-6">
            <p class="flex items-center gap-3">
              <span class="tabular grid h-9 w-9 place-items-center rounded-full bg-dark text-sm font-extrabold text-white">{s.n}</span>
              <h3 class="text-lg font-extrabold" data-site={`how_steps.${i}.t`}>{s.title}</h3>
            </p>
            <p class="mt-2 text-sm text-slate-600" data-site={`how_steps.${i}.d`}>{s.text}</p>
          </div>
        </article>
      ))}
    </div>
    <article class="group mt-5 grid overflow-hidden rounded-2xl bg-white ring-1 ring-slate-900/10 shadow-sm transition-all duration-300 hover:shadow-xl md:grid-cols-2" style="border-radius:20px">
      <div class="flex flex-col justify-center p-6 sm:p-10">
        <p class="flex items-center gap-3">
          <span class="tabular grid h-9 w-9 place-items-center rounded-full bg-dark text-sm font-extrabold text-white">{last.n}</span>
          <h3 class="text-xl sm:text-2xl font-extrabold" data-site="how_steps.3.t">{last.title}</h3>
        </p>
        <p class="mt-3 text-slate-600" data-site="how_steps.3.d">{last.text}</p>
        <div class="mt-5">
          <a href="/order?plan=professional" class="btn-active inline-block rounded-full bg-primary px-6 py-3 text-sm font-bold text-white hover:bg-primary-hover">Start my project →</a>
        </div>
      </div>
      <div class="overflow-hidden">
        <img src={last.img} alt="" loading="lazy" decoding="async" width="900" height="450" class="h-full min-h-[240px] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
    </article>
  </div>
</section>
