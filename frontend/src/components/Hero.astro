---
import RatingBadge from './RatingBadge.astro';
import MarqueeCarousel from './MarqueeCarousel.astro';
const shots = [1,2,3,4,5,6].map((n) => `https://picsum.photos/seed/logopulse-hero-${n}/400/250.webp`);
---
<section class="reveal reveal-stagger relative overflow-hidden pt-36 pb-14 sm:pt-44">
  <div aria-hidden="true" class="pointer-events-none absolute -top-28 left-1/2 h-96 w-[46rem] max-w-none -translate-x-1/2">
    <div class="glow-drift h-full w-full rounded-full" style="background: radial-gradient(ellipse at center, rgba(1,88,254,0.16), transparent 70%); filter: blur(12px);"></div>
  </div>
  <div class="relative mx-auto max-w-content px-5 text-center">
    <div style="--i:0">
      <span class="inline-flex items-center gap-2 rounded-full bg-subtle px-4 py-1.5 text-xs font-bold text-primary"><span class="dot-pulse h-2 w-2 rounded-full bg-primary"></span><span data-site="hero.badge">ACCEPTING NEW PROJECTS — 3 SLOTS LEFT THIS WEEK</span></span>
    </div>
    <h1 class="mx-auto mt-6 max-w-3xl text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.05]" style="--i:1"><span data-site="hero.t1">A logo that sells, ready in </span><em class="font-serif-accent font-medium text-primary" data-site="hero.t2">48 hours</em><span data-site="hero.t3"> — or your </span><em class="font-serif-accent font-medium text-primary" data-site="hero.t4">money back</em></h1>
    <p class="mx-auto mt-5 max-w-xl text-slate-600 text-base sm:text-lg" style="--i:2" data-site="hero.sub">
      Custom logo &amp; brand identity for startups. From $49. No templates, no contests, no waiting weeks.
    </p>
    <div class="mt-4 flex justify-center" style="--i:3"><RatingBadge /></div>
    <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-3" style="--i:4">
      <a href="/#pricing" data-site="hero.cta1" class="btn-active btn-shine cta-animated w-full sm:w-auto rounded-full bg-gradient-to-r from-primary via-primary-hover to-primary px-8 py-4 text-base font-bold text-white shadow-xl shadow-primary/25 hover:shadow-primary/40">View Pricing — from $49</a>
      <a href="/#portfolio" data-site="hero.cta2" class="btn-active w-full sm:w-auto rounded-full bg-dark px-8 py-4 text-base font-bold text-white hover:bg-slate-800">See Our Work</a>
    </div>
    <dl class="mx-auto mt-10 grid max-w-2xl grid-cols-3 gap-4 text-center" style="--i:5">
      <div><dt class="sr-only">Delivery time</dt><dd class="text-2xl sm:text-3xl font-extrabold tabular" data-site="hero.s1v">48h</dd><dd class="text-xs sm:text-sm text-slate-500 font-semibold" data-site="hero.s1l">avg. delivery</dd></div>
      <div><dt class="sr-only">Projects delivered</dt><dd class="text-2xl sm:text-3xl font-extrabold tabular" data-site="hero.s2v">2,400+</dd><dd class="text-xs sm:text-sm text-slate-500 font-semibold" data-site="hero.s2l">logos delivered</dd></div>
      <div><dt class="sr-only">Satisfaction</dt><dd class="text-2xl sm:text-3xl font-extrabold tabular" data-site="hero.s3v">100%</dd><dd class="text-xs sm:text-sm text-slate-500 font-semibold" data-site="hero.s3l">money-back promise</dd></div>
    </dl>
  </div>
  <div class="mt-12" style="--i:6">
    <MarqueeCarousel>
      {shots.map((src, i) => (
        <img src={src} alt={`LogoPulse portfolio sample ${i + 1}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" fetchpriority={i < 2 ? 'high' : 'low'} width="400" height="250" class="h-44 sm:h-56 w-auto shrink-0 rounded-2xl object-cover ring-1 ring-slate-900/10" style="border-radius:16px" />
      ))}
    </MarqueeCarousel>
  </div>
</section>
