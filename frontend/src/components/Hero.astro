---
import RatingBadge from './RatingBadge.astro';
import MarqueeCarousel from './MarqueeCarousel.astro';
---
<section class="reveal reveal-stagger relative overflow-hidden pt-32 pb-10 sm:pt-40">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-[-10rem] h-[30rem] w-[30rem] max-w-none">
    <div class="glow-drift h-full w-full rounded-full" style="background: radial-gradient(ellipse at center, rgba(1,88,254,0.14), transparent 70%); filter: blur(12px);"></div>
  </div>
  <div class="relative mx-auto max-w-content px-5">
    <div class="grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h1 class="text-5xl sm:text-6xl xl:text-7xl font-extrabold tracking-tight leading-[1.02]" style="--i:0"><span data-site="hero.t1">A logo that sells, ready in </span><em class="font-serif-accent font-medium text-primary" data-site="hero.t2">48 hours</em><span data-site="hero.t3"> — or your </span><em class="font-serif-accent font-medium text-primary" data-site="hero.t4">money back</em></h1>
        <p class="mt-5 max-w-xl text-slate-600 text-base sm:text-lg" style="--i:1" data-site="hero.sub">
          Custom logo &amp; brand identity for startups. From $49. No templates, no contests, no waiting weeks.
        </p>
        <div class="mt-7 flex flex-col sm:flex-row sm:items-center gap-3" style="--i:2">
          <a href="/#pricing" data-site="hero.cta1" class="btn-active btn-shine cta-animated rounded-full bg-gradient-to-r from-primary via-primary-hover to-primary px-8 py-4 text-base font-bold text-white shadow-xl shadow-primary/25 hover:shadow-primary/40 text-center">View Pricing — from $49</a>
          <a href="/#portfolio" data-site="hero.cta2" class="btn-active rounded-full bg-dark px-8 py-4 text-base font-bold text-white hover:bg-slate-800 text-center">See Our Work</a>
        </div>
        <div class="mt-6 flex items-center gap-3" style="--i:3">
          <div class="flex -space-x-2.5" aria-hidden="true">
            {[47, 12, 32].map((n) => (
              <img src={`https://i.pravatar.cc/64?img=${n}`} alt="" width="32" height="32" loading="lazy" decoding="async" class="h-8 w-8 rounded-full object-cover ring-2 ring-white" />
            ))}
          </div>
          <RatingBadge />
        </div>
      </div>
      <div class="relative lg:col-span-5" style="--i:2">
        <div class="overflow-hidden rounded-2xl ring-1 ring-slate-900/10 shadow-2xl shadow-slate-900/10" style="border-radius:20px">
          <img src="https://picsum.photos/seed/logopulse-hero-1/640/560.webp" alt="LogoPulse portfolio sample" width="640" height="560" fetchpriority="high" decoding="async" class="aspect-[8/7] w-full object-cover" />
        </div>
      </div>
    </div>
    <dl class="mt-12 grid grid-cols-3 gap-4 border-y border-slate-200 py-6 text-center sm:divide-x sm:divide-slate-200" style="--i:4">
      <div class="px-2"><dt class="sr-only">Delivery time</dt><dd class="text-2xl sm:text-3xl font-extrabold tabular" data-site="hero.s1v">48h</dd><dd class="text-xs sm:text-sm text-slate-500 font-semibold" data-site="hero.s1l">avg. delivery</dd></div>
      <div class="px-2"><dt class="sr-only">Projects delivered</dt><dd class="text-2xl sm:text-3xl font-extrabold tabular" data-site="hero.s2v">2,400+</dd><dd class="text-xs sm:text-sm text-slate-500 font-semibold" data-site="hero.s2l">logos delivered</dd></div>
      <div class="px-2"><dt class="sr-only">Satisfaction</dt><dd class="text-2xl sm:text-3xl font-extrabold tabular" data-site="hero.s3v">100%</dd><dd class="text-xs sm:text-sm text-slate-500 font-semibold" data-site="hero.s3l">money-back promise</dd></div>
    </dl>
  </div>
  <div class="mt-10" style="--i:5">
    <MarqueeCarousel>
      {[1,2,3,4,5,6].map((n) => (
        <img src={`https://picsum.photos/seed/logopulse-hero-${n}/400/250.webp`} alt={`LogoPulse portfolio sample ${n}`} loading="lazy" decoding="async" width="400" height="250" class="h-40 sm:h-52 w-auto shrink-0 rounded-2xl object-cover ring-1 ring-slate-900/10" style="border-radius:16px" />
      ))}
    </MarqueeCarousel>
  </div>
</section>
