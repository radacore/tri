---
---
<section class="reveal reveal-stagger relative overflow-hidden pt-32 pb-12 sm:pt-44">
  <div class="relative mx-auto max-w-content px-5">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h1 class="font-display max-w-xl font-extrabold leading-[1.0] tracking-tight" style="--i:0">
          <span class="block text-4xl sm:text-6xl" data-site="hero.t1">A logo that sells,</span>
          <span class="block text-4xl sm:text-6xl text-primary" data-site="hero.t2">ready in 48 hours</span>
          <span class="block text-4xl sm:text-6xl"><span data-site="hero.t3">— or your </span><em class="font-serif-accent font-medium normal-case" data-site="hero.t4">money back</em></span>
        </h1>
        <p class="mt-5 max-w-xl text-slate-600 text-base sm:text-lg" style="--i:1" data-site="hero.sub">
          Custom logo &amp; brand identity for startups. From $49. No templates, no contests, no waiting weeks.
        </p>
        <div class="mt-7 flex flex-col sm:flex-row gap-3" style="--i:2">
          <a href="/#pricing" data-site="hero.cta1" class="btn-active btn-shine cta-animated rounded-full bg-primary px-8 py-4 text-base font-bold text-white shadow-xl shadow-primary/25 hover:bg-primary-hover text-center">View Pricing — from $49</a>
          <a href="/#portfolio" data-site="hero.cta2" class="btn-active rounded-full bg-dark px-8 py-4 text-base font-bold text-white hover:bg-slate-800 text-center">See Our Work</a>
        </div>
      </div>
      <div class="relative" style="--i:3" aria-hidden="true">
        <div class="v-collage v-mask relative mx-auto grid max-h-[630px] grid-cols-2 gap-4 overflow-hidden sm:grid-cols-3">
          {[0, 1, 2].map((col) => (
            <div class={`overflow-hidden ${col === 2 ? 'hidden sm:block' : ''}`}>
              <div class={`v-track ${col % 2 === 0 ? 'v-track-up' : 'v-track-down'}`}>
                {[0, 1, 2, 3].map((k) => [0, 1].map((dup) => (
                  <img src={`https://picsum.photos/seed/lp-c${col}-${k}/400/${k % 2 === 0 ? 350 : 266}.webp`} alt="" width="400" height={k % 2 === 0 ? 350 : 266} loading="lazy" decoding="async" class="w-full rounded-2xl object-cover ring-1 ring-slate-900/10" style="border-radius:16px" />
                )))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
