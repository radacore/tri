---
const logos = ['NEXORA', 'Cloudgrid', 'Saffron&Co', 'VitalCare', 'Atelier Nord', 'PulseFit', 'Kopi Lantai', 'Maison Rue'];
---
<section class="reveal border-y border-slate-100 bg-slate-50/60 py-8" aria-label="Trusted by">
  <p class="text-center text-xs font-bold uppercase tracking-[0.2em] text-slate-400" data-i18n="logos.heading">Trusted by 2,400+ startups</p>
  <div class="marquee mt-5" role="presentation">
    <div class="marquee-track items-center">
      {[...logos, ...logos].map((name) => (
        <span class="shrink-0 text-lg font-extrabold tracking-tight text-slate-400 grayscale hover:text-slate-700 hover:grayscale-0 transition">{name}</span>
      ))}
    </div>
  </div>
</section>
