---
// Fallback = isi seed DB (key pricing). Admin dapat mengubah nama, harga,
// tag, CTA, dan fitur tiap tier dari /identity — landing menimpa saat load.
const FALLBACK_TIERS = [
  { id: 'starter', name: 'Starter', price: '$49', price_cents: 4900, tag: 'Logo only', cta: 'Start with Starter', features: ['1 original logo concept', '2 revision rounds', '48-hour delivery', 'PNG + JPG files', '100% money-back'], popular: false },
  { id: 'professional', name: 'Professional', price: '$149', price_cents: 14900, tag: 'Most popular', cta: 'Choose Professional', features: ['3 original logo concepts', 'Unlimited revisions (7 days)', '48-hour delivery', 'Full vector kit (AI, SVG, EPS, PDF)', 'Brand mini-guide (colors + fonts)', 'Social media pack', '100% money-back'], popular: true },
  { id: 'premium', name: 'Premium', price: '$399', price_cents: 39900, tag: 'Full identity', cta: 'Go Premium', features: ['Everything in Professional', 'Complete brand identity system', 'Stationery + mockup suite', 'Brand guideline book (12+ pages)', 'Priority 24-hour support', '100% money-back'], popular: false },
];
---
<section class="reveal reveal-stagger mx-auto max-w-content px-5 py-16 sm:py-20">
  <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary text-center" data-site="sections.price_kicker">Pricing</p>
  <h2 class="mt-2 text-center text-3xl sm:text-4xl font-extrabold tracking-tight" data-site="sections.price_title">One payment. Yours forever.</h2>
  <p class="mt-3 text-center text-slate-500" data-site="sections.price_sub">No subscriptions. 100% money-back guarantee on every plan.</p>
  <div class="mt-10 grid gap-6 md:grid-cols-3 items-stretch">
    {FALLBACK_TIERS.map((p, i) => (
      <article
        class={`relative flex flex-col p-7 bg-white transition-all duration-300 hover:-translate-y-2 ${p.popular ? 'ring-2 ring-primary shadow-2xl shadow-primary/15 hover:[transform:translateY(-8px)]' : 'ring-1 ring-slate-900/10 shadow-sm hover:shadow-xl'}`}
        style={`--i:${i};border-radius:20px`}
      >
        {p.popular && <span class="badge-pop absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-primary px-4 py-1 text-xs font-extrabold uppercase tracking-wider text-white shadow-lg" data-site="sections.price_popular">Most Popular</span>}
        <h3 class="text-lg font-extrabold" data-site={`pricing.tiers.${i}.name`}>{p.name}</h3>
        <p class="text-sm text-slate-500" data-site={`pricing.tiers.${i}.tag`}>{p.tag}</p>
        <p class="mt-3"><span class="text-4xl font-extrabold tabular" data-site-price={`pricing.tiers.${i}.price_cents`}>{p.price}</span><span class="text-sm text-slate-500" data-site="sections.price_onetime"> one-time</span></p>
        <ul class="mt-5 space-y-2.5 text-sm flex-1" data-site-features={`pricing.tiers.${i}.features`}>
          {p.features.map((f, j) => (<li class="flex gap-2"><span class="text-primary font-bold" aria-hidden="true">✓</span><span data-site={`pricing.tiers.${i}.features.${j}`}>{f}</span></li>))}
        </ul>
        <a href={`/order?plan=${p.id}`} data-site={`pricing.tiers.${i}.cta`} class={`btn-active mt-6 rounded-full px-6 py-3.5 text-center text-sm font-bold ${p.popular ? 'btn-shine cta-animated bg-gradient-to-r from-primary via-primary-hover to-primary text-white shadow-lg shadow-primary/25' : 'bg-dark text-white hover:bg-slate-800'}`}>{p.cta}</a>
      </article>
    ))}
  </div>
</section>
