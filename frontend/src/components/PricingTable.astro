---
const plans = [
  { name: 'Starter', price: 49, tagKey: 'price.tag.s', tag: 'Logo only', ctaKey: 'price.cta.s', cta: 'Start with Starter', features: [['price.f.s1', '1 original logo concept'], ['price.f.s2', '2 revision rounds'], ['price.f.s3', '48-hour delivery'], ['price.f.s4', 'PNG + JPG files'], ['price.f.s5', '100% money-back']], popular: false },
  { name: 'Professional', price: 149, tagKey: 'price.tag.p', tag: 'Most popular', ctaKey: 'price.cta.p', cta: 'Choose Professional', features: [['price.f.p1', '3 original logo concepts'], ['price.f.p2', 'Unlimited revisions (7 days)'], ['price.f.p3', '48-hour delivery'], ['price.f.p4', 'Full vector kit (AI, SVG, EPS, PDF)'], ['price.f.p5', 'Brand mini-guide (colors + fonts)'], ['price.f.p6', 'Social media pack'], ['price.f.p7', '100% money-back']], popular: true },
  { name: 'Premium', price: 399, tagKey: 'price.tag.l', tag: 'Full identity', ctaKey: 'price.cta.l', cta: 'Go Premium', features: [['price.f.l1', 'Everything in Professional'], ['price.f.l2', 'Complete brand identity system'], ['price.f.l3', 'Stationery + mockup suite'], ['price.f.l4', 'Brand guideline book (12+ pages)'], ['price.f.l5', 'Priority 24-hour support'], ['price.f.l6', '100% money-back']], popular: false },
];
---
<section class="reveal reveal-stagger mx-auto max-w-content px-5 py-16 sm:py-20">
  <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary text-center" data-i18n="price.kicker">Pricing</p>
  <h2 class="mt-2 text-center text-3xl sm:text-4xl font-extrabold tracking-tight" data-i18n="price.title">One payment. Yours forever.</h2>
  <p class="mt-3 text-center text-slate-500" data-i18n="price.sub">No subscriptions. 100% money-back guarantee on every plan.</p>
  <div class="mt-10 grid gap-6 md:grid-cols-3 items-stretch">
    {plans.map((p, i) => (
      <article
        class={`relative flex flex-col p-7 bg-white transition-all duration-300 hover:-translate-y-2 ${p.popular ? 'ring-2 ring-primary shadow-2xl shadow-primary/15 hover:[transform:translateY(-8px)]' : 'ring-1 ring-slate-900/10 shadow-sm hover:shadow-xl'}`}
        style={`--i:${i};border-radius:20px`}
      >
        {p.popular && <span class="badge-pop absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-primary px-4 py-1 text-xs font-extrabold uppercase tracking-wider text-white shadow-lg" data-i18n="price.popular">Most Popular</span>}
        <h3 class="text-lg font-extrabold">{p.name}</h3>
        <p class="text-sm text-slate-500" data-i18n={p.tagKey}>{p.tag}</p>
        <p class="mt-3"><span class="text-4xl font-extrabold tabular">${p.price}</span><span class="text-sm text-slate-500" data-i18n="price.onetime"> one-time</span></p>
        <ul class="mt-5 space-y-2.5 text-sm flex-1">
          {p.features.map((f) => (<li class="flex gap-2"><span class="text-primary font-bold" aria-hidden="true">✓</span><span data-i18n={f[0]}>{f[1]}</span></li>))}
        </ul>
        <a href={`/order?plan=${p.name.toLowerCase()}`} data-i18n={p.ctaKey} class={`btn-active mt-6 rounded-full px-6 py-3.5 text-center text-sm font-bold ${p.popular ? 'btn-shine cta-animated bg-gradient-to-r from-primary via-primary-hover to-primary text-white shadow-lg shadow-primary/25' : 'bg-dark text-white hover:bg-slate-800'}`}>{p.cta}</a>
      </article>
    ))}
  </div>
</section>
