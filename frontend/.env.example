# Salin ke .env untuk menimpa default lokal.
# API backend (default: http://localhost:8080/api/v1)
PUBLIC_API_URL=http://localhost:8080/api/v1
# URL situs publik untuk canonical/OG (default: https://brandingpulse.example.com)
PUBLIC_SITE_URL=http://localhost:4321
# Konten contoh (stok foto, logo klien pihak lain, case study fiktif) HANYA untuk
# demo lokal. Biarkan kosong/0 di produksi agar section kosong disembunyikan.
PUBLIC_DEMO_CONTENT=0
